<Window x:Class="RuinaoSoftwareWpf.Views.Dialogs.StimulationImpedanceDiagnosticDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="920"
        Height="720"
        MinWidth="860"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <Style x:Key="DiagnosticButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#252D3A" />
            <Setter Property="Foreground" Value="#E7ECF3" />
            <Setter Property="BorderBrush" Value="#485468" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#303A49" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1D2430" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#171D27" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#303846" />
                                <Setter Property="Foreground" Value="#657082" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChannelButton" TargetType="Button" BasedOn="{StaticResource DiagnosticButton}">
            <Setter Property="Width" Value="104" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8794A7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E5EAF1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#3A4557" BorderThickness="1" Background="#111722" CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="62" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1B2230" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="22,0,12,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="阻抗诊断" Foreground="#F2F5F9" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="业务板通道阻抗原始值与映射（Debug）" Foreground="#8996A9" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Width="34" Height="34" Content="×" FontSize="20"
                            Background="Transparent" Foreground="#AEB8C7" BorderThickness="0"
                            Cursor="Hand" Click="CloseButton_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding SummaryText}" Foreground="#E3E9F1" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding RefreshFeedbackText}" Foreground="#62D98B" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding ErrorText}" Foreground="#F08F80" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="更新阻抗" Command="{Binding RefreshCommand}"
                            Style="{StaticResource DiagnosticButton}" VerticalAlignment="Top" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="#151C27" BorderBrush="#303B4D" BorderThickness="1" CornerRadius="5" Padding="16">
                        <StackPanel>
                            <TextBlock Text="通道" Foreground="#F0F4F8" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />
                            <ItemsControl ItemsSource="{Binding Channels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ChannelButton}"
                                                Command="{Binding DataContext.SelectChannelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <TextBlock Text="{Binding ChannelText}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}"
                                                         HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="#171E2A" BorderBrush="#303B4D" BorderThickness="1" CornerRadius="5" Height="245">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedChannel.ImpedanceText}"
                                               Foreground="{Binding SelectedChannel.StatusBrush}"
                                               FontSize="42" HorizontalAlignment="Center" />
                                    <TextBlock Text="阻抗" Foreground="#8996A9" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#171E2A" BorderBrush="#303B4D" BorderThickness="1" CornerRadius="5" Padding="20">
                                <StackPanel>
                                    <Grid Margin="0,0,0,15">
                                        <TextBlock Text="{Binding SelectedChannel.ChannelText, StringFormat={}{0} 状态监控}" Foreground="#F0F4F8" FontSize="17" />
                                        <TextBlock Text="{Binding SelectedChannel.StatusText}" Foreground="{Binding SelectedChannel.StatusBrush}"
                                                   FontSize="14" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Separator Background="#303A49" />
                                    <Grid Height="40"><TextBlock Text="逻辑通道" Style="{StaticResource LabelText}" /><TextBlock Text="{Binding SelectedChannel.ChannelText}" Style="{StaticResource ValueText}" /></Grid>
                                    <Grid Height="40"><TextBlock Text="业务板" Style="{StaticResource LabelText}" /><TextBlock Text="{Binding SelectedChannel.BoardText}" Style="{StaticResource ValueText}" /></Grid>
                                    <Grid Height="40"><TextBlock Text="物理通道" Style="{StaticResource LabelText}" /><TextBlock Text="{Binding SelectedChannel.PhysicalChannelText}" Style="{StaticResource ValueText}" /></Grid>
                                    <Grid Height="40"><TextBlock Text="最后成功读取" Style="{StaticResource LabelText}" /><TextBlock Text="{Binding SelectedChannel.LastReadText}" Style="{StaticResource ValueText}" /></Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="#171E2A" BorderBrush="#303B4D" BorderThickness="1" CornerRadius="5" Padding="20" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="原始数据" Foreground="#F0F4F8" FontSize="16" FontWeight="SemiBold" />
                                <Grid Margin="0,15,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.35*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="寄存器" Style="{StaticResource LabelText}" /><TextBlock Text="{Binding SelectedChannel.RegisterText}" Foreground="#DCE4EF" FontFamily="Consolas" Margin="0,8,0,0" /></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="原始值 Hex" Style="{StaticResource LabelText}" /><TextBlock Text="{Binding SelectedChannel.RawHexText}" Foreground="#DCE4EF" FontFamily="Consolas" Margin="0,8,0,0" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="原始值 UInt32" Style="{StaticResource LabelText}" /><TextBlock Text="{Binding SelectedChannel.RawDecimalText}" Foreground="#DCE4EF" FontFamily="Consolas" Margin="0,8,0,0" /></StackPanel>
                                    <StackPanel Grid.Column="3"><TextBlock Text="换算" Style="{StaticResource LabelText}" /><TextBlock Text="{Binding SelectedChannel.ConversionText}" Foreground="#DCE4EF" FontFamily="Consolas" Margin="0,8,0,0" /></StackPanel>
                                </Grid>
                                <Border Background="#382D16" BorderBrush="#B58B31" BorderThickness="0,0,0,0" Padding="12,9" Margin="0,16,0,0">
                                    <TextBlock Text="原始值为 0 时按阻抗不可用处理；第一次读取失败保留当前值，连续第二次失败后该业务板通道显示灰色“—”。"
                                               Foreground="#E8C873" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="#171E29" BorderBrush="#2C3544" BorderThickness="0,1,0,0">
                <Grid Margin="22,0">
                    <TextBlock Text="诊断信息仅用于 Debug，不替代正式界面的阻抗状态。" Foreground="#8996A9" VerticalAlignment="Center" />
                    <Button Content="关闭" Style="{StaticResource DiagnosticButton}" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Click="CloseButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
