<UserControl x:Class="RuinaoSoftwareWpf.Views.AssessmentEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#11141D">
    <UserControl.Resources>
        <Style x:Key="AssessmentEntryPrimaryButton" TargetType="Button">
            <Setter Property="MinWidth" Value="238" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="32,10" />
            <Setter Property="Background" Value="#C48229" />
            <Setter Property="BorderBrush" Value="#DDA04C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#CF8B31" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#E4AA59" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#B97722" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="42,30,42,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#303643" BorderThickness="0,0,0,1" Padding="0,0,0,18">
            <TextBlock Text="{Binding PageTitleText}"
                       Foreground="#F1F3F6"
                       FontSize="24"
                       FontWeight="SemiBold" />
        </Border>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,0,0,28">
            <Border MinWidth="520"
                    BorderBrush="#303744"
                    BorderThickness="0,1,0,1"
                    Padding="26,16"
                    Margin="0,0,0,34">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding CurrentPatientLabelText}"
                               Foreground="#95A4BC"
                               FontSize="13"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentPatientName}"
                               Foreground="#F1F3F6"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="24,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentPatientCode}"
                               Foreground="#95A4BC"
                               FontSize="13"
                               Margin="24,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Button Content="{Binding PrimaryActionText}"
                    Command="{Binding PrimaryActionCommand}"
                    Visibility="{Binding IsPrimaryActionVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource AssessmentEntryPrimaryButton}" />

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#E47979"
                       FontSize="12"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="620"
                       Margin="0,18,0,0"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>
    </Grid>
</UserControl>
