<UserControl x:Class="RuinaoSoftwareWpf.Views.AssessmentEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#11141D">
    <UserControl.Resources>
        <Style x:Key="AssessmentEntryPrimaryButton" TargetType="Button">
            <Setter Property="MinWidth" Value="238" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="32,10" />
            <Setter Property="Background" Value="#C48229" />
            <Setter Property="BorderBrush" Value="#DDA04C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#CF8B31" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#E4AA59" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#B97722" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AssessmentEntrySelectPatientButton" TargetType="Button">
            <Setter Property="MinWidth" Value="178" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="28,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#C48229" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F1F3F6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1D2330" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#DDA04C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#252C39" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="42,30,42,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#303643" BorderThickness="0,0,0,1" Padding="0,0,0,18">
            <TextBlock Text="{Binding PageTitleText}"
                       Foreground="#F1F3F6"
                       FontSize="24"
                       FontWeight="SemiBold" />
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,28">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsPrimaryActionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border MinWidth="520"
                        BorderBrush="#303744"
                        BorderThickness="0,1,0,1"
                        Padding="26,16"
                        Margin="0,0,0,34">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding CurrentPatientLabelText}"
                                       Foreground="#95A4BC"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentPatientName}"
                                       Foreground="#F1F3F6"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="24,0,0,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentPatientCode}"
                                       Foreground="#95A4BC"
                                       FontSize="13"
                                       Margin="24,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="{Binding MatchPatientActionText}"
                                Command="{Binding MatchPatientCommand}"
                                Style="{StaticResource AssessmentEntrySelectPatientButton}"
                                MinWidth="110"
                                Height="32"
                                Padding="16,5"
                                FontSize="12"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Button Content="{Binding PrimaryActionText}"
                        Command="{Binding PrimaryActionCommand}"
                        Style="{StaticResource AssessmentEntryPrimaryButton}" />

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#E47979"
                           FontSize="12"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="620"
                           Margin="0,18,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsNoPatientState, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="&#xE77B;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="44"
                           Foreground="#6F7F98"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20" />
                <TextBlock Text="{Binding NoPatientTitleText}"
                           Foreground="#F1F3F6"
                           FontSize="24"
                           FontWeight="SemiBold"
                           TextAlignment="Center" />
                <TextBlock Text="{Binding NoPatientDescriptionText}"
                           Foreground="#95A4BC"
                           FontSize="14"
                           TextAlignment="Center"
                           Margin="0,12,0,30" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="{Binding SelectPatientActionText}"
                            Command="{Binding SelectPatientCommand}"
                            Style="{StaticResource AssessmentEntrySelectPatientButton}" />
                    <Button Content="{Binding MatchPatientActionText}"
                            Command="{Binding MatchPatientCommand}"
                            Style="{StaticResource AssessmentEntrySelectPatientButton}"
                            Margin="12,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#E47979"
                           FontSize="12"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="620"
                           Margin="0,18,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
