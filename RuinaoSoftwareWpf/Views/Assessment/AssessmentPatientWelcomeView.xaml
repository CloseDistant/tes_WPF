<UserControl x:Class="RuinaoSoftwareWpf.Views.AssessmentPatientWelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#11141D">
    <Grid Margin="42,30,42,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource AssessmentPageHeader}">
            <TextBlock Text="数字表型采集"
                       Style="{StaticResource AssessmentPageTitle}" />
        </Border>

        <Border Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="860"
                Margin="0,0,0,46"
                Padding="54,38,54,42"
                Background="#171B25"
                BorderBrush="#303643"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel>
                <TextBlock Text="&#xE77B;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="42"
                           Foreground="#8295B4"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,18" />
                <TextBlock Text="{Binding TitleText}"
                           Foreground="#F1F3F6"
                           FontSize="30"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <Border Height="1"
                        Width="72"
                        Background="#C48229"
                        HorizontalAlignment="Center"
                        Margin="0,22,0,24" />
                <TextBlock Text="{Binding WelcomeMessageText}"
                           Width="720"
                           MaxWidth="720"
                           TextWrapping="Wrap"
                           TextAlignment="Left"
                           LineHeight="28"
                           Foreground="#C2CAD8"
                           FontSize="16" />
                <Button Content="{Binding EnterActionText}"
                        Command="{Binding EnterCommand}"
                        Width="250"
                        Height="54"
                        HorizontalAlignment="Center"
                        Margin="0,32,0,0"
                        Foreground="#FFFFFF"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        FocusVisualStyle="{x:Null}">
                    <Button.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonSurface"
                                                Background="#A96F24"
                                                BorderBrush="#C28A3A"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="18,0"
                                                SnapsToDevicePixels="True">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="14"
                                                                    ShadowDepth="3"
                                                                    Direction="270"
                                                                    Opacity="0.28"
                                                                    Color="#000000" />
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              RecognizesAccessKey="True" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonSurface" Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#BE8738" Offset="0" />
                                                            <GradientStop Color="#A96F24" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#D4A05A" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ButtonSurface" Property="Background" Value="#89591A" />
                                                <Setter TargetName="ButtonSurface" Property="Effect" Value="{x:Null}" />
                                                <Setter TargetName="ButtonSurface" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <TranslateTransform Y="1" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ButtonSurface" Property="Background" Value="#454A55" />
                                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#5D6472" />
                                                <Setter Property="Foreground" Value="#A6ADBA" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
