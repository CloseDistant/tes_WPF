<UserControl x:Class="RuinaoSoftwareWpf.Views.AssessmentPatientMatchingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#11141D">
    <UserControl.Resources>
        <Style x:Key="MatchingOutlineButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="18,6" />
            <Setter Property="Background" Value="#1A202C" />
            <Setter Property="BorderBrush" Value="#3A4353" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F1F3F6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#252D3B" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#687A96" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#252C39" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MatchingComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#D8E0EC" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#252D3B" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#303B4E" />
                    <Setter Property="Foreground" Value="#F1F3F6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MatchingComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#D8E0EC" />
            <Setter Property="Background" Value="#1A202C" />
            <Setter Property="BorderBrush" Value="#3A4353" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource MatchingComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <ContentPresenter Margin="10,0,28,0"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <Path Data="M 0 0 L 4 4 L 8 0"
                                          Stroke="#8B9AB0"
                                          StrokeThickness="1.5"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0" />
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="DropDown"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border Background="#1A202C"
                                        BorderBrush="#3A4353"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="220">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" SourceName="DropDownToggle" Value="True">
                                <Setter TargetName="DropDownToggle" Property="BorderBrush" Value="#687A96" />
                                <Setter TargetName="DropDownToggle" Property="Background" Value="#252D3B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DropDownToggle" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MatchingRow" TargetType="Border">
            <Setter Property="Background" Value="#171C27" />
            <Setter Property="BorderBrush" Value="#2B3342" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="16,13" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#202735" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="42,30,42,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="‹"
                    Command="{Binding BackCommand}"
                    Style="{StaticResource MatchingOutlineButton}"
                    Width="42"
                    MinWidth="42"
                    Padding="0"
                    FontSize="22"
                    Margin="0,0,16,0" />
            <TextBlock Grid.Column="1"
                       Text="{Binding PageTitleText}"
                       Foreground="#F1F3F6"
                       FontSize="24"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1"
                Background="#1A202C"
                BorderBrush="#303744"
                BorderThickness="1"
                Padding="16"
                Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PhoneLabelText}"
                           Foreground="#D8E0EC"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <TextBox Grid.Column="1"
                         Text="{Binding PhoneQuery, UpdateSourceTrigger=PropertyChanged}"
                         Height="36"
                         Padding="10,6"
                         Background="#11141D"
                         BorderBrush="#3A4353"
                         BorderThickness="1"
                         Foreground="#F1F3F6"
                         FontSize="13"
                         ToolTip="{Binding PhoneQueryHintText}" />
                <Button Grid.Column="2"
                        Content="{Binding SearchActionText}"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource MatchingOutlineButton}"
                        Margin="12,0,0,0" />
                <TextBlock Grid.Column="3"
                           Text="{Binding PhoneQueryHintText}"
                           Foreground="#7F8DA3"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="16,0,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="姓名" Foreground="#7F8DA3" FontSize="12" />
                <TextBlock Grid.Column="1" Text="手机号" Foreground="#7F8DA3" FontSize="12" />
                <TextBlock Grid.Column="2" Text="类型" Foreground="#7F8DA3" FontSize="12" />
                <TextBlock Grid.Column="3" Text="研究中心" Foreground="#7F8DA3" FontSize="12" />
                <TextBlock Grid.Column="4" Text="批次号" Foreground="#7F8DA3" FontSize="12" />
                <TextBlock Grid.Column="5" Text="患者 ID" Foreground="#7F8DA3" FontSize="12" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Patients}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource MatchingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.6*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.2*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="#F1F3F6" FontSize="13" />
                                        <TextBlock Grid.Column="1" Text="{Binding Phone}" Foreground="#D8E0EC" FontSize="13" />
                                        <TextBlock Grid.Column="2" Text="{Binding Type}" Foreground="#D8E0EC" FontSize="13" />
                                        <TextBlock Grid.Column="3" Text="{Binding DepartmentName}" Foreground="#D8E0EC" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" Text="{Binding BatchNumber}" Foreground="#D8E0EC" FontSize="13" />
                                        <TextBlock Grid.Column="5" Text="{Binding PatientId}" Foreground="#D8E0EC" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding EmptyResultText}"
                               Foreground="#7F8DA3"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Margin="0,40,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasResults}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#E47979"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,16,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="16,14,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding PageSummaryText}"
                           Foreground="#7F8DA3"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="{Binding PreviousPageText}"
                        Command="{Binding PreviousPageCommand}"
                        Style="{StaticResource MatchingOutlineButton}"
                        MinWidth="72"
                        Margin="8,0,0,0" />
                <TextBox Grid.Column="2"
                         Text="{Binding PageNumberInput, UpdateSourceTrigger=PropertyChanged}"
                         Width="52"
                         Height="34"
                         Padding="8,5"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"
                         Background="#11141D"
                         BorderBrush="#3A4353"
                         BorderThickness="1"
                         Foreground="#F1F3F6"
                         FontSize="13"
                         Margin="8,0,4,0" />
                <TextBlock Grid.Column="3"
                           Text="/"
                           Foreground="#7F8DA3"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0" />
                <TextBlock Grid.Column="4"
                           Text="{Binding TotalPage}"
                           Foreground="#D8E0EC"
                           FontSize="13"
                           VerticalAlignment="Center"
                           MinWidth="28" />
                <Button Grid.Column="5"
                        Content="{Binding GoToPageText}"
                        Command="{Binding GoToPageCommand}"
                        Style="{StaticResource MatchingOutlineButton}"
                        MinWidth="64"
                        Margin="8,0,0,0" />
                <Button Grid.Column="6"
                        Content="{Binding NextPageText}"
                        Command="{Binding NextPageCommand}"
                        Style="{StaticResource MatchingOutlineButton}"
                        MinWidth="72"
                        Margin="8,0,0,0" />
                <StackPanel Grid.Column="7"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <TextBlock Text="{Binding PageSizeText}"
                               Foreground="#7F8DA3"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding PageSizeOptions}"
                              SelectedItem="{Binding SelectedPageSize}"
                              Style="{StaticResource MatchingComboBox}"
                              Width="64"
                              Height="34"
                              FontSize="12"
                              VerticalContentAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
