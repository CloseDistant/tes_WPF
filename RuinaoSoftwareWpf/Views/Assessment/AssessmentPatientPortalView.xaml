<UserControl x:Class="RuinaoSoftwareWpf.Views.AssessmentPatientPortalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#11141D">
    <UserControl.Resources>
        <Style x:Key="PortalActionButton" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="Background" Value="#C48229" />
            <Setter Property="BorderBrush" Value="#D99A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#D99A3A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#A96E20" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#202734" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#30394A" />
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="#718097" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PortalBackButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#171E2A" />
            <Setter Property="BorderBrush" Value="#D6DCE6" />
            <Setter Property="BorderThickness" Value="0.75" />
            <Setter Property="Foreground" Value="#F1F3F6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BackRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="←"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Margin="0,-2,6,0" />
                                <ContentPresenter Margin="0"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  RecognizesAccessKey="True" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackRoot" Property="Background" Value="#202938" />
                                <Setter TargetName="BackRoot" Property="BorderBrush" Value="#D99A3A" />
                                <Setter Property="Foreground" Value="#F1F3F6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BackRoot" Property="Background" Value="#C48229" />
                                <Setter TargetName="BackRoot" Property="BorderBrush" Value="#F1B24A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BackRoot" Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PortalFollowUpButton" TargetType="Button" BasedOn="{StaticResource PortalActionButton}">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="124" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="#C48229" />
            <Setter Property="BorderBrush" Value="#D99A3A" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="42,30,42,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource AssessmentPageHeader}"
                Margin="0,0,0,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Command="{Binding BackCommand}"
                        HorizontalAlignment="Left"
                        Content="{Binding BackActionText}"
                        Style="{StaticResource PortalBackButton}"
                        Margin="0,0,14,0" />
                <TextBlock Grid.Column="1"
                           Text="{Binding PageTitleText}"
                           Style="{StaticResource AssessmentPageTitle}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" MaxWidth="980" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Grid.RowSpan="3"
                    Background="#171C26"
                    BorderBrush="#303B4C"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="22,20,22,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PhoneLabelText}"
                                   VerticalAlignment="Center"
                                   Foreground="#F1F3F6"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,18,0" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding PhoneQuery, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="20"
                                 Height="44"
                                 Padding="13,8"
                                 Background="#11141D"
                                 BorderBrush="#3E4B60"
                                 BorderThickness="1"
                                 Foreground="#F1F3F6"
                                 FontSize="16"
                                 VerticalContentAlignment="Center"
                                 FocusVisualStyle="{x:Null}" />
                        <Button Grid.Column="2"
                                Content="{Binding SearchActionText}"
                                Command="{Binding SearchCommand}"
                                Margin="12,0,0,0"
                                Width="112"
                                Style="{StaticResource PortalActionButton}" />
                    </Grid>
                    <TextBlock Grid.Row="1"
                               Text="{Binding PhoneHintText}"
                               Margin="92,10,0,0"
                               Foreground="#8996AA"
                               FontSize="13" />
                    <TextBlock Grid.Row="2"
                               Text="{Binding ErrorMessage}"
                               Margin="0,16,0,0"
                               Foreground="#F07878"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,28,0,0">
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding HasPatient, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding PatientNameText}"
                               Foreground="#F1F3F6"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PatientPhoneText}"
                               Foreground="#9AA8BD"
                               FontSize="18"
                               Margin="36,2,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding FollowUpTitleText}"
                           Margin="0,24,0,10"
                           Foreground="#C48229"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Visibility="{Binding HasPatient, Converter={StaticResource BoolToVisibilityConverter}}" />
                <ItemsControl ItemsSource="{Binding FollowUps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,1"
                                    Padding="0,12,0,12"
                                    BorderBrush="#2C3443"
                                    BorderThickness="0,0,0,1"
                                    MaxWidth="900">
                                <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding SettingName}"
                                               Foreground="#E4E8EF"
                                               FontSize="15" />
                                    <TextBlock Text="{Binding FlowStatusName}"
                                               Foreground="#8996AA"
                                               FontSize="13"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{Binding DataContext.SelectFollowUpText, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        Command="{Binding DataContext.SelectFollowUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource PortalFollowUpButton}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding EmptyResultText}"
                           Foreground="#8996AA"
                           FontSize="15"
                           Visibility="{Binding ShowEmptyResult, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
