<Window x:Class="RuinaoSoftwareWpf.Views.Dialogs.StimulationPrescriptionPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择处方"
        Width="920"
        Height="620"
        MinWidth="780"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei">
    <Window.Resources>
        <Style x:Key="PrescriptionListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#E8EDF5" />
            <Setter Property="Background" Value="#252E3D" />
            <Setter Property="BorderBrush" Value="#394456" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#2C3545" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#536075" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#332F29" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#E29A2D" />
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2,1,1,1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A4BC" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DetailValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2F5FA" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DetailSeparatorStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#354053" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
    </Window.Resources>

    <Border Background="#1E2735"
            BorderBrush="#445066"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="92" />
                <RowDefinition Height="*" />
                <RowDefinition Height="76" />
            </Grid.RowDefinitions>

            <Border BorderBrush="#344054" BorderThickness="0,0,0,1" Padding="28,18">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="×"
                            Width="42"
                            Height="42"
                            FontSize="22"
                            Foreground="#E8EDF5"
                            Background="#293446"
                            BorderBrush="#455269"
                            BorderThickness="1"
                            Click="CancelClick" />
                    <StackPanel>
                        <TextBlock FontSize="23" FontWeight="SemiBold">
                            <Run Text="选择 " />
                            <Run Text="{Binding StimulationType, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Foreground="#E7A13A" />
                            <Run Text=" 处方" />
                        </TextBlock>
                        <TextBlock Text="仅显示与当前刺激模式匹配的处方"
                                   Foreground="#8FA0B8"
                                   FontSize="12"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="应用范围"
                               Foreground="#9AA9BF"
                               FontSize="13"
                               VerticalAlignment="Center" />
                    <Border Background="#352F26"
                            BorderBrush="#795522"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,4"
                            Margin="10,0,0,0">
                        <TextBlock Text="{Binding ApplyScopeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Foreground="#F0AE45"
                                   FontSize="12" />
                    </Border>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="PrescriptionList"
                             ItemsSource="{Binding Prescriptions, RelativeSource={RelativeSource AncestorType=Window}}"
                             SelectedItem="{Binding SelectedPrescription, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource PrescriptionListItemStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="PrescriptionSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Column="2"
                            Background="#222C3B"
                            BorderBrush="#3B475B"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="24">
                        <Grid>
                            <StackPanel DataContext="{Binding SelectedPrescription, RelativeSource={RelativeSource AncestorType=Window}}">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Foreground="#F3F6FA"
                                           Margin="0,0,0,16" />
                                <StackPanel>
                                    <Border BorderBrush="#354053" BorderThickness="0,0,0,1" Padding="0,11">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentDisplay}" Style="{StaticResource DetailValueStyle}" />
                                            <TextBlock Text="幅值" Style="{StaticResource DetailLabelStyle}" />
                                        </DockPanel>
                                    </Border>
                                    <Border BorderBrush="#354053" BorderThickness="0,0,0,1" Padding="0,11">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding RampUpDisplay}" Style="{StaticResource DetailValueStyle}" />
                                            <TextBlock Text="{Binding RampUpLabel}" Style="{StaticResource DetailLabelStyle}" />
                                        </DockPanel>
                                    </Border>
                                    <Border BorderBrush="#354053" BorderThickness="0,0,0,1" Padding="0,11">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPulseCurrent}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding RampDownDisplay}" Style="{StaticResource DetailValueStyle}" />
                                            <TextBlock Text="{Binding RampDownLabel}" Style="{StaticResource DetailLabelStyle}" />
                                        </DockPanel>
                                    </Border>
                                    <Border BorderBrush="#354053" BorderThickness="0,0,0,1" Padding="0,11">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TotalDurationDisplay}" Style="{StaticResource DetailValueStyle}" />
                                            <TextBlock Text="{Binding TotalDurationLabel}" Style="{StaticResource DetailLabelStyle}" />
                                        </DockPanel>
                                    </Border>
                                    <Border BorderBrush="#354053" BorderThickness="0,0,0,1" Padding="0,11">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding IntervalDisplay}" Style="{StaticResource DetailValueStyle}" />
                                            <TextBlock Text="{Binding IntervalLabel}" Style="{StaticResource DetailLabelStyle}" />
                                        </DockPanel>
                                    </Border>
                                    <Border BorderBrush="#354053" BorderThickness="0,0,0,1" Padding="0,11">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SessionDurationDisplay}" Style="{StaticResource DetailValueStyle}" />
                                            <TextBlock Text="{Binding SessionDurationLabel}" Style="{StaticResource DetailLabelStyle}" />
                                        </DockPanel>
                                    </Border>
                                    <Border Padding="0,11">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPulseCurrent}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding DeliveryMode}" Style="{StaticResource DetailValueStyle}" />
                                            <TextBlock Text="模式" Style="{StaticResource DetailLabelStyle}" />
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="暂无可用处方"
                                       Foreground="#8291A8"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPrescription, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2" BorderBrush="#344054" BorderThickness="0,1,0,0" Padding="24,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消"
                            Width="88"
                            Height="40"
                            Margin="0,0,10,0"
                            Foreground="#E8EDF5"
                            Background="#303B4D"
                            BorderBrush="#48556C"
                            BorderThickness="1"
                            Click="CancelClick" />
                    <Button x:Name="ApplyButton"
                            Content="应用处方"
                            Width="112"
                            Height="40"
                            Foreground="White"
                            Background="#D88F24"
                            BorderBrush="#E5A341"
                            BorderThickness="1"
                            IsEnabled="False"
                            Click="ApplyClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
