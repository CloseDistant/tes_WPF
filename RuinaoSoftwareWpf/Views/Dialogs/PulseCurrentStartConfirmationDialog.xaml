<Window x:Class="RuinaoSoftwareWpf.Views.Dialogs.PulseCurrentStartConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="开始刺激前确认"
        Width="800"
        SizeToContent="Height"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="PulseConfirmButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="148" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Background" Value="#252D3B" />
            <Setter Property="Foreground" Value="#EAF1FB" />
            <Setter Property="BorderBrush" Value="#46536A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#303A4B" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#D0903E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#364154" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Foreground" Value="#677286" />
                                <Setter TargetName="Surface" Property="Background" Value="#1B222E" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#30394A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PulseConfirmPrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PulseConfirmButtonStyle}">
            <Setter Property="Background" Value="#27B65A" />
            <Setter Property="BorderBrush" Value="#27B65A" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style x:Key="PulseParameterCellStyle" TargetType="Border">
            <Setter Property="Background" Value="#151D2A" />
            <Setter Property="BorderBrush" Value="#303B4E" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="15,12" />
        </Style>
        <Style x:Key="PulseParameterLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8FA1BA" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="PulseParameterValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="#F0F5FC" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Border Background="#1A2331"
            BorderBrush="#3E4B60"
            BorderThickness="1"
            CornerRadius="8"
            MouseLeftButtonDown="DialogRoot_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#202938"
                    BorderBrush="#303B4E"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0"
                    Padding="28,20,20,18">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="开始刺激前确认"
                                   Foreground="#F0F5FC"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="SubtitleText"
                                   Margin="0,4,0,0"
                                   Foreground="#9FB0C6"
                                   FontSize="13" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Width="30"
                            Height="30"
                            Padding="0"
                            Content="×"
                            FontSize="19"
                            Foreground="#B6C3D6"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CancelButton_Click" />
                </Grid>
            </Border>

            <Border x:Name="ImpedanceStatusBorder"
                    Grid.Row="1"
                    Margin="28,22,28,0"
                    Padding="16,13"
                    CornerRadius="5"
                    BorderThickness="1">
                <Grid>
                    <TextBlock Text="通道状态检查通过"
                               Foreground="#DCE6F4"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="ImpedanceStatusText"
                               HorizontalAlignment="Right"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Margin="28,22,28,0">
                <TextBlock Text="输出参数"
                           Margin="0,0,0,9"
                           Foreground="#CAD6E7"
                           FontSize="14"
                           FontWeight="SemiBold" />
                <Border BorderBrush="#303B4E" BorderThickness="1" CornerRadius="4">
                    <UniformGrid Columns="4">
                        <Border Style="{StaticResource PulseParameterCellStyle}">
                            <StackPanel>
                                <TextBlock Text="幅值" Style="{StaticResource PulseParameterLabelStyle}" />
                                <TextBlock x:Name="CurrentText" Style="{StaticResource PulseParameterValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PulseParameterCellStyle}">
                            <StackPanel>
                                <TextBlock Text="极性" Style="{StaticResource PulseParameterLabelStyle}" />
                                <TextBlock x:Name="PolarityText" Style="{StaticResource PulseParameterValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PulseParameterCellStyle}">
                            <StackPanel>
                                <TextBlock Text="脉冲宽度" Style="{StaticResource PulseParameterLabelStyle}" />
                                <TextBlock x:Name="PulseWidthText" Style="{StaticResource PulseParameterValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Background="#151D2A" Padding="15,12">
                            <StackPanel>
                                <TextBlock Text="目标通道" Style="{StaticResource PulseParameterLabelStyle}" />
                                <TextBlock x:Name="ChannelText" Style="{StaticResource PulseParameterValueStyle}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="28,22,28,0">
                <TextBlock Text="时间参数"
                           Margin="0,0,0,9"
                           Foreground="#CAD6E7"
                           FontSize="14"
                           FontWeight="SemiBold" />
                <Border BorderBrush="#303B4E" BorderThickness="1" CornerRadius="4">
                    <UniformGrid Columns="4">
                        <Border Style="{StaticResource PulseParameterCellStyle}">
                            <StackPanel>
                                <TextBlock Text="上升宽度" Style="{StaticResource PulseParameterLabelStyle}" />
                                <TextBlock x:Name="RiseWidthText" Style="{StaticResource PulseParameterValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PulseParameterCellStyle}">
                            <StackPanel>
                                <TextBlock Text="间隔宽度" Style="{StaticResource PulseParameterLabelStyle}" />
                                <TextBlock x:Name="IntervalWidthText" Style="{StaticResource PulseParameterValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PulseParameterCellStyle}">
                            <StackPanel>
                                <TextBlock Text="治疗时间" Style="{StaticResource PulseParameterLabelStyle}" />
                                <TextBlock x:Name="DurationText" Style="{StaticResource PulseParameterValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Background="#151D2A" Padding="15,12">
                            <StackPanel>
                                <TextBlock Text="总次数" Style="{StaticResource PulseParameterLabelStyle}" />
                                <TextBlock x:Name="PlannedCountText" Style="{StaticResource PulseParameterValueStyle}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Border>
            </StackPanel>

            <Border x:Name="NoticeBorder"
                    Grid.Row="4"
                    Margin="28,24,28,0"
                    Padding="16,13"
                    Background="#172435"
                    BorderBrush="#4A9FE5"
                    BorderThickness="3,0,0,0">
                <TextBlock x:Name="NoticeText"
                           Foreground="#D9E8FA"
                           TextWrapping="Wrap" />
            </Border>

            <Border Grid.Row="5"
                    Margin="0,22,0,0"
                    Padding="28,20"
                    Background="#1C2533"
                    BorderBrush="#303B4E"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="返回修改"
                            Margin="0,0,12,0"
                            Style="{StaticResource PulseConfirmButtonStyle}"
                            Click="CancelButton_Click" />
                    <Button Content="确认并开始"
                            Style="{StaticResource PulseConfirmPrimaryButtonStyle}"
                            Click="ConfirmButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
