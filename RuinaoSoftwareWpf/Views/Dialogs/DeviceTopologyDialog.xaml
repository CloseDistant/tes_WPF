<Window x:Class="RuinaoSoftwareWpf.Views.Dialogs.DeviceTopologyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1180"
        Height="650"
        MinWidth="1000"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <Style x:Key="TopologyButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#252D3A" />
            <Setter Property="Foreground" Value="#E7ECF3" />
            <Setter Property="BorderBrush" Value="#485468" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#303A49" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1D2430" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#171D27" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#303846" />
                                <Setter Property="Foreground" Value="#657082" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#151C27" />
            <Setter Property="Foreground" Value="#DCE3EC" />
            <Setter Property="BorderBrush" Value="#354052" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#2C3544" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#202837" />
            <Setter Property="Foreground" Value="#AEB9C8" />
            <Setter Property="BorderBrush" Value="#354052" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="#151C27" />
            <Setter Property="Foreground" Value="#DCE3EC" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1C2533" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#263346" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#3A4557"
            BorderThickness="1"
            Background="#111722"
            CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1B2230" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="20,0,12,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="设备拓扑" Foreground="#F2F5F9" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="背板槽位与在线业务板诊断（Debug）" Foreground="#8996A9" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            Width="34"
                            Height="34"
                            Content="×"
                            FontSize="20"
                            Background="Transparent"
                            Foreground="#AEB8C7"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20,16,20,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding SummaryText}" Foreground="#E4EAF2" FontSize="14" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <TextBlock Text="槽位位图  " Foreground="#7F8CA0" />
                        <TextBlock Text="{Binding SlotBitmapText}" Foreground="#AFC5E5" FontFamily="Consolas" />
                        <TextBlock Text="    扫描时间  " Foreground="#7F8CA0" />
                        <TextBlock Text="{Binding CapturedAtText}" Foreground="#AFC5E5" />
                    </StackPanel>
                    <TextBlock Text="{Binding RefreshFeedbackText}"
                               Foreground="#62D98B"
                               FontSize="12"
                               Margin="0,7,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRefreshFeedback}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="重新扫描"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource TopologyButton}"
                        VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="2" Margin="20,0">
                <DataGrid ItemsSource="{Binding Slots}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="槽位" Binding="{Binding SlotIndex}" Width="58" />
                        <DataGridTextColumn Header="地址" Binding="{Binding AddressText}" Width="72" />
                        <DataGridTextColumn Header="插板状态" Binding="{Binding InsertedText}" Width="90" />
                        <DataGridTextColumn Header="在线状态" Binding="{Binding OnlineText}" Width="82" />
                        <DataGridTextColumn Header="板类型" Binding="{Binding BoardKindText}" Width="96" />
                        <DataGridTextColumn Header="身份文本" Binding="{Binding IdentityText}" Width="130" />
                        <DataGridTextColumn Header="0x0500～0x0503 原始值" Binding="{Binding IdentityRegistersText}" Width="245" />
                        <DataGridTextColumn Header="耗时" Binding="{Binding ElapsedText}" Width="82" />
                        <DataGridTextColumn Header="判定说明" Binding="{Binding StatusMessage}" Width="*" MinWidth="230" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="#3A241E"
                        BorderBrush="#A75F48"
                        BorderThickness="1"
                        Padding="12,9"
                        VerticalAlignment="Bottom"
                        Margin="12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ErrorText}" Foreground="#F0B9A8" TextWrapping="Wrap" />
                </Border>
            </Grid>

            <Border Grid.Row="3" Background="#171E29" BorderBrush="#2C3544" BorderThickness="0,1,0,0">
                <Grid Margin="20,0">
                    <TextBlock Text="识别策略：当前阶段，通信正常的在线业务板暂按电刺激板处理。"
                               Foreground="#A99369"
                               VerticalAlignment="Center" />
                    <Button Content="关闭"
                            Style="{StaticResource TopologyButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
