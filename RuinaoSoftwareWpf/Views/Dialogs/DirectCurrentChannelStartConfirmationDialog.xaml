<Window x:Class="RuinaoSoftwareWpf.Views.Dialogs.DirectCurrentChannelStartConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="开始刺激前确认"
        Width="640"
        SizeToContent="Height"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Width" Value="140" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="#272C38" />
            <Setter Property="Foreground" Value="#E4E8EF" />
            <Setter Property="BorderBrush" Value="#3A4050" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#2D3342" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#D0903E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#343A4A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="Surface" Property="Background" Value="#20242E" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#303542" />
                                <Setter Property="Foreground" Value="#667083" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8E96A8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E4E8EF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Border Background="#1C202B"
            BorderBrush="#3A4050"
            BorderThickness="1"
            CornerRadius="8"
            MouseLeftButtonDown="DialogRoot_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.45" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#202532"
                    CornerRadius="8,8,0,0"
                    BorderBrush="#303645"
                    BorderThickness="0,0,0,1"
                    Padding="22,18">
                <StackPanel>
                    <TextBlock Text="开始刺激前确认"
                               Foreground="#E4E8EF"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ChannelSubtitleText"
                               Margin="0,5,0,0"
                               Foreground="#8E96A8"
                               FontSize="12" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="#171B25" Padding="22,20,22,0">
                <Border x:Name="ImpedanceStatusBorder"
                        Padding="14,11"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ImpedanceStatusText"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="ImpedanceValueText"
                                   Grid.Column="1"
                                   FontSize="16"
                                   FontWeight="Bold" />
                    </Grid>
                </Border>
            </Border>

            <Border Grid.Row="2" Background="#171B25" Padding="22,18,22,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="#1D222D"
                            BorderBrush="#303746"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="输出参数" Foreground="#D0903E" FontWeight="SemiBold" Margin="0,0,0,14" />
                            <TextBlock Text="幅值" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="CurrentText" Style="{StaticResource FieldValue}" Margin="0,0,0,13" />
                            <TextBlock Text="极性" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="PolarityText" Style="{StaticResource FieldValue}" Margin="0,0,0,13" />
                            <TextBlock Text="模式" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="ModeText" Style="{StaticResource FieldValue}" Margin="0,0,0,13" />
                            <TextBlock Text="目标通道" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="ChannelText" Style="{StaticResource FieldValue}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="#1D222D"
                            BorderBrush="#303746"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="时间参数" Foreground="#D0903E" FontWeight="SemiBold" Margin="0,0,0,14" />
                            <TextBlock Text="渐升 / 渐降" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="RampText" Style="{StaticResource FieldValue}" Margin="0,0,0,13" />
                            <TextBlock Text="刺激总时间" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="TotalDurationText" Style="{StaticResource FieldValue}" Margin="0,0,0,13" />
                            <TextBlock Text="单次时长" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="SingleDurationText" Style="{StaticResource FieldValue}" Margin="0,0,0,13" />
                            <TextBlock Text="间隔时间" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="IntervalText" Style="{StaticResource FieldValue}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Background="#1C202B"
                    CornerRadius="0,0,8,8"
                    BorderBrush="#303645"
                    BorderThickness="0,1,0,0"
                    Padding="18,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="返回修改"
                            Style="{StaticResource DialogButton}"
                            Margin="0,0,10,0"
                            Click="CancelButton_Click" />
                    <Button Content="确认并开始"
                            Style="{StaticResource DialogButton}"
                            Background="#2A7B47"
                            BorderBrush="#36A661"
                            Click="ConfirmButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
