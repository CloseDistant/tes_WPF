<Window x:Class="RuinaoSoftwareWpf.Views.Dialogs.DirectCurrentSynchronizedStartConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="同步开始确认"
        Width="500"
        SizeToContent="Height"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Width" Value="140" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="#272C38" />
            <Setter Property="Foreground" Value="#E4E8EF" />
            <Setter Property="BorderBrush" Value="#3A4050" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#2D3342" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#D0903E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#343A4A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="Surface" Property="Background" Value="#20242E" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#303542" />
                                <Setter Property="Foreground" Value="#667083" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1C202B"
            BorderBrush="#3A4050"
            BorderThickness="1"
            CornerRadius="8"
            MouseLeftButtonDown="DialogRoot_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.45" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#202532"
                    CornerRadius="8,8,0,0"
                    BorderBrush="#303645"
                    BorderThickness="0,0,0,1"
                    Padding="22,18">
                <StackPanel>
                    <TextBlock Text="同步开始确认"
                               Foreground="#E4E8EF"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="经颅直流电刺激"
                               Margin="0,5,0,0"
                               Foreground="#8E96A8"
                               FontSize="12" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="#171B25" Padding="24,24,24,22">
                <StackPanel>
                    <TextBlock Text="即将执行同步开始。"
                               Foreground="#E4E8EF"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ScopeText"
                               Margin="0,14,0,0"
                               Foreground="#B5BECD"
                               FontSize="14"
                               LineHeight="23"
                               TextWrapping="Wrap" />
                    <Border Margin="0,18,0,0"
                            Padding="12,10"
                            Background="#262316"
                            BorderBrush="#6C5422"
                            BorderThickness="1"
                            CornerRadius="4">
                        <TextBlock Text="确认后，系统才会继续校验参数和阻抗状态。"
                                   Foreground="#E6BC61"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Text="是否确认继续？"
                               Margin="0,18,0,0"
                               Foreground="#E4E8EF"
                               FontSize="14"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Background="#1C202B"
                    CornerRadius="0,0,8,8"
                    BorderBrush="#303645"
                    BorderThickness="0,1,0,0"
                    Padding="18,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消"
                            Style="{StaticResource DialogButton}"
                            Margin="0,0,10,0"
                            Click="CancelButton_Click" />
                    <Button Content="确认同步开始"
                            Style="{StaticResource DialogButton}"
                            Background="#2A7B47"
                            BorderBrush="#36A661"
                            Click="ConfirmButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
