<UserControl x:Class="RuinaoSoftwareWpf.Views.TiControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RuinaoSoftwareWpf"
             xmlns:controls="clr-namespace:RuinaoSoftwareWpf.Views.Controls"
             Background="#11141D">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#171B25"
                BorderBrush="#242A36"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="18,8">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button Content="{Binding Localization.BackText}"
                            Command="{Binding BackCommand}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource BackNavigationButton}"
                            Margin="0,0,0,12"
                            ToolTip="返回电刺激模式选择" />
                    <TextBlock Text="{Binding Localization.ModeTitleText}"
                               Foreground="{StaticResource Gold}"
                               FontWeight="SemiBold"
                               FontSize="16" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:TiGroup}">
                            <Border Tag="{Binding}">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick"
                                                  Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                        <Setter Property="Padding" Value="7,5" />
                                        <Setter Property="Margin" Value="0,0,0,4" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource Gold}" />
                                                <Setter Property="BorderThickness" Value="1.5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,3">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{StaticResource Gold}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding DeltaText}"
                                                   Foreground="{StaticResource SubText}"
                                                   FontSize="12"
                                                   HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Channels}"
                                                  ItemTemplate="{StaticResource ChannelMiniTemplate}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding Localization.SynchronizedStartButtonText}"
                            Style="{StaticResource TopButton}"
                            Background="#27B65A"
                            Padding="24,8"
                            MinWidth="96"
                            Command="{Binding StartCommand}" />
                    <Button Content="{Binding Localization.EmergencyStopButtonText}"
                            Style="{StaticResource TopButton}"
                            Background="{StaticResource Danger}"
                            Padding="24,8"
                            MinWidth="96"
                            Command="{Binding EmergencyStopCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding SelectedGroup.Title}"
                           Foreground="{StaticResource Gold}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <Button Content="使用处方"
                        Style="{StaticResource PrescriptionUseButton}"
                        Command="{Binding UsePrescriptionCommand}"
                        DockPanel.Dock="Left" />
            </DockPanel>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedGroup.Channels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ChannelConfig}">
                        <controls:StimulationChannelCard Margin="0,0,14,0"
                                                         Localization="{Binding DataContext.Localization, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         StartCommand="{Binding DataContext.StartChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         StopCommand="{Binding DataContext.StopChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         UsePrescriptionCommand="{Binding DataContext.UseChannelPrescriptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         ParameterValidationFailedCommand="{Binding DataContext.ParameterValidationFailedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         ShowCarrierFrequency="True"
                                                         ShowPolarity="False"
                                                         IsAlternatingCurrent="True"
                                                         EnableSimulatedWaveform="True"
                                                         ShowMode="True"
                                                         ShowIntervalTime="True"
                                                         ShowSingleDuration="True"
                                                         ShowElectrodeDescription="True" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Border Grid.ColumnSpan="2"
                Panel.ZIndex="100"
                Background="#B30B0F17"
                Visibility="{Binding IsParameterDownloadVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Width="520"
                    Padding="28,26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#1C202B"
                    BorderBrush="#3A4353"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="正在下发刺激参数"
                               Foreground="#E8EDF6"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,8,0,0"
                               Text="请稍候，参数下发期间不能修改或重复开始。"
                               Foreground="#919DB0"
                               FontSize="13" />
                    <DockPanel Margin="0,24,0,8">
                        <TextBlock Text="总体进度"
                                   Foreground="#AAB4C5"
                                   FontSize="13" />
                        <TextBlock Text="{Binding ParameterDownloadPercentageText}"
                                   Foreground="#E8EDF6"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                    </DockPanel>
                    <ProgressBar Height="9"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ParameterDownloadPercentage, Mode=OneWay}" />
                    <TextBlock Margin="0,10,0,0"
                               Text="{Binding ParameterDownloadStatus}"
                               Foreground="#8D99AC"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                    <Border Margin="0,22,0,0"
                            Padding="12,10"
                            Background="#242115"
                            BorderBrush="#665020"
                            BorderThickness="1"
                            CornerRadius="4">
                        <TextBlock Text="全部参数确认完成后，系统将自动同步开始刺激。"
                                   Foreground="#E1B75A"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
