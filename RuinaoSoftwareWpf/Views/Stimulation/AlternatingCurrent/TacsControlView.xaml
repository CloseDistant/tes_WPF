<UserControl x:Class="RuinaoSoftwareWpf.Views.TacsControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RuinaoSoftwareWpf"
             xmlns:controls="clr-namespace:RuinaoSoftwareWpf.Views.Controls"
             Background="#11141D">
    <UserControl.Resources>
        <Style x:Key="TacsPairCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1D232E" />
            <Setter Property="BorderBrush" Value="#2A3240" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="TacsChannelChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#252B37" />
            <Setter Property="BorderBrush" Value="#303846" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#332D23" />
                    <Setter Property="BorderBrush" Value="{StaticResource Gold}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid PreviewMouseLeftButtonDown="CommitFocusedInputOnBlankClick">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#171B25"
                BorderBrush="#242A36"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="18,8">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button Content="{Binding Localization.BackText}"
                            Command="{Binding BackCommand}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource BackNavigationButton}"
                            Margin="0,0,0,12"
                            ToolTip="返回电刺激模式选择" />
                    <TextBlock Text="{Binding Localization.AlternatingCurrentModeTitleText}"
                               Foreground="{StaticResource Gold}"
                               FontWeight="SemiBold"
                               FontSize="16" />
                    <TextBlock Text="{Binding Localization.TranscranialAlternatingCurrentText}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,3,0,0" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding ChannelPairs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:StimulationChannelPair}">
                            <Border Style="{StaticResource TacsPairCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            DataContext="{Binding FirstChannel}"
                                            Style="{StaticResource TacsChannelChipStyle}">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick"
                                                          Command="{Binding DataContext.SelectChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <Grid>
                                            <Border Width="3"
                                                    HorizontalAlignment="Left"
                                                    Margin="-5,-3,0,-3"
                                                    Background="{StaticResource Gold}"
                                                    CornerRadius="2"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <DockPanel Margin="3,0,0,0">
                                                <Ellipse Style="{StaticResource StimulationChannelStatusIndicator}"
                                                         DockPanel.Dock="Right" />
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2"
                                            DataContext="{Binding SecondChannel}"
                                            Style="{StaticResource TacsChannelChipStyle}">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick"
                                                          Command="{Binding DataContext.SelectChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <Grid>
                                            <Border Width="3"
                                                    HorizontalAlignment="Left"
                                                    Margin="-5,-3,0,-3"
                                                    Background="{StaticResource Gold}"
                                                    CornerRadius="2"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <DockPanel Margin="3,0,0,0">
                                                <Ellipse Style="{StaticResource StimulationChannelStatusIndicator}"
                                                         DockPanel.Dock="Right" />
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,14" LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Content="使用处方"
                        Style="{StaticResource PrescriptionUseButton}"
                        Command="{Binding UsePrescriptionCommand}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding Localization.SynchronizedStartButtonText}"
                            Style="{StaticResource TopButton}"
                            Background="#27B65A"
                            Padding="24,8"
                            MinWidth="96"
                            Command="{Binding SynchronizedStartCommand}" />
                    <Button Content="{Binding Localization.EmergencyStopButtonText}"
                            Style="{StaticResource TopButton}"
                            Background="{StaticResource Danger}"
                            Padding="24,8"
                            MinWidth="96"
                            Command="{Binding EmergencyStopCommand}" />
                </StackPanel>
            </DockPanel>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedChannels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ChannelConfig}">
                        <controls:StimulationChannelCard Margin="0,0,14,0"
                                                         Localization="{Binding DataContext.Localization, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         StartCommand="{Binding DataContext.StartChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         StopCommand="{Binding DataContext.StopChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         UsePrescriptionCommand="{Binding DataContext.UseChannelPrescriptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         ParameterValidationFailedCommand="{Binding DataContext.ParameterValidationFailedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         SelectCommand="{Binding DataContext.SelectChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         ShowCarrierFrequency="True"
                                                         ShowPolarity="False"
                                                         IsAlternatingCurrent="True"
                                                         AlternatingCurrentModeCode="tACS"
                                                         EnableSimulatedWaveform="True"
                                                         ShowMode="True"
                                                         ShowIntervalTime="True"
                                                         ShowSingleDuration="True"
                                                         ShowElectrodeDescription="True"
                                                         HighlightBorder="{Binding IsSelected}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Border Grid.ColumnSpan="2"
                Panel.ZIndex="100"
                Background="#B30B0F17"
                Visibility="{Binding IsParameterDownloadVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Width="520"
                    Padding="28,26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#1C202B"
                    BorderBrush="#3A4353"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="正在下发刺激参数"
                               Foreground="#E8EDF6"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,8,0,0"
                               Text="请稍候，参数下发期间不能修改或重复开始。"
                               Foreground="#919DB0"
                               FontSize="13" />
                    <DockPanel Margin="0,24,0,8">
                        <TextBlock Text="总体进度" Foreground="#AAB4C5" FontSize="13" />
                        <TextBlock Text="{Binding ParameterDownloadPercentageText}"
                                   Foreground="#E8EDF6"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                    </DockPanel>
                    <ProgressBar Height="9"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ParameterDownloadPercentage, Mode=OneWay}" />
                    <TextBlock Margin="0,10,0,0"
                               Text="{Binding ParameterDownloadStatus}"
                               Foreground="#8D99AC"
                               FontSize="12" />
                    <Border Margin="0,22,0,0"
                            Padding="12,10"
                            Background="#242115"
                            BorderBrush="#665020"
                            BorderThickness="1"
                            CornerRadius="4">
                        <TextBlock Text="全部参数确认完成后，系统将自动开始刺激。"
                                   Foreground="#E1B75A"
                                   FontSize="13" />
                    </Border>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
