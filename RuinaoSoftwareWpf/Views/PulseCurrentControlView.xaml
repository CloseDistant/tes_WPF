<UserControl x:Class="RuinaoSoftwareWpf.Views.PulseCurrentControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RuinaoSoftwareWpf"
             xmlns:renderers="clr-namespace:RuinaoSoftwareWpf.Views.Renderers"
             Background="#11141D">
    <UserControl.Resources>
        <Style x:Key="PulsePairCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1D232E" />
            <Setter Property="BorderBrush" Value="#2A3240" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="PulseChannelChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#252B37" />
            <Setter Property="BorderBrush" Value="#303846" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#332D23" />
                    <Setter Property="BorderBrush" Value="{StaticResource Gold}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PulseLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9EABC0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PulseWaveformModeOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8593AA" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="OptionSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="12,4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OptionSurface"
                                        Property="Background"
                                        Value="#252F3F" />
                                <Setter Property="Foreground" Value="#D7DFEA" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OptionSurface"
                                        Property="Background"
                                        Value="#313A49" />
                                <Setter Property="Foreground" Value="#F1B24A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PulseFieldStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource StimulationFieldBox}">
            <Setter Property="Width" Value="118" />
            <Setter Property="Height" Value="34" />
        </Style>

        <Style x:Key="PulseReadOnlyFieldStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource PulseFieldStyle}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="#8994A7" />
            <Setter Property="Background" Value="#292F3C" />
            <Setter Property="BorderBrush" Value="#343B49" />
        </Style>

        <Style x:Key="PulseCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1B202C" />
            <Setter Property="BorderBrush" Value="#303846" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="MinHeight" Value="640" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Gold}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#171B25"
                BorderBrush="#242A36"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="18,8">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button Content="{Binding Localization.BackText}"
                            Command="{Binding BackCommand}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource BackNavigationButton}"
                            Margin="0,0,0,12"
                            ToolTip="返回电刺激模式选择" />
                    <TextBlock Text="{Binding Localization.PulseCurrentModeTitleText}"
                               Foreground="{StaticResource Gold}"
                               FontWeight="SemiBold"
                               FontSize="16" />
                    <TextBlock Text="{Binding Localization.TranscranialPulseCurrentText}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,3,0,0" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding ChannelPairs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:PulseCurrentChannelPair}">
                            <Border Style="{StaticResource PulsePairCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            DataContext="{Binding FirstChannel}"
                                            Style="{StaticResource PulseChannelChipStyle}">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick"
                                                          Command="{Binding DataContext.SelectChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <Grid>
                                            <Border Width="3"
                                                    HorizontalAlignment="Left"
                                                    Margin="-5,-3,0,-3"
                                                    Background="{StaticResource Gold}"
                                                    CornerRadius="2"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <DockPanel Margin="3,0,0,0">
                                                <Ellipse Style="{StaticResource StimulationChannelStatusIndicator}"
                                                         DockPanel.Dock="Right" />
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12" FontWeight="SemiBold" />
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="2"
                                            DataContext="{Binding SecondChannel}"
                                            Style="{StaticResource PulseChannelChipStyle}">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick"
                                                          Command="{Binding DataContext.SelectChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <Grid>
                                            <Border Width="3"
                                                    HorizontalAlignment="Left"
                                                    Margin="-5,-3,0,-3"
                                                    Background="{StaticResource Gold}"
                                                    CornerRadius="2"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <DockPanel Margin="3,0,0,0">
                                                <Ellipse Style="{StaticResource StimulationChannelStatusIndicator}"
                                                         DockPanel.Dock="Right" />
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12" FontWeight="SemiBold" />
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,14" LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Content="使用处方"
                        Style="{StaticResource PrescriptionUseButton}"
                        Command="{Binding UsePrescriptionCommand}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{Binding Localization.SynchronizedStartButtonText}"
                            Style="{StaticResource TopButton}"
                            Background="#27B65A"
                            Padding="24,8"
                            MinWidth="96"
                            Command="{Binding SynchronizedStartCommand}" />
                    <Button Content="{Binding Localization.EmergencyStopButtonText}"
                            Style="{StaticResource TopButton}"
                            Background="{StaticResource Danger}"
                            Padding="24,8"
                            MinWidth="96"
                            Command="{Binding EmergencyStopCommand}" />
                </StackPanel>
            </DockPanel>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedChannels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:PulseCurrentChannelConfig}">
                        <Border Style="{StaticResource PulseCardStyle}"
                                PreviewMouseLeftButtonDown="ChannelCard_SelectOnInteraction"
                                GotKeyboardFocus="ChannelCard_SelectOnInteraction">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="使用处方"
                                                Command="{Binding DataContext.UseChannelPrescriptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PrescriptionUseButton}"
                                                Margin="0,0,10,0" />
                                        <Button Content="{Binding DataContext.Localization.StartButtonText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Command="{Binding DataContext.StartChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TopButton}"
                                                Background="#27B65A"
                                                Height="32"
                                                MinWidth="70"
                                                Padding="14,5"
                                                Margin="0,0,12,0" />
                                        <TextBlock Text="{Binding DataContext.Localization.RemainingTimeLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Foreground="{StaticResource SubText}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />
                                        <Border Background="#303644" CornerRadius="5" Padding="14,6">
                                            <TextBlock Text="{Binding RemainingTime}"
                                                       FontFamily="Consolas"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                </DockPanel>

                                <Grid Grid.Row="1" Margin="0,22,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="1" Background="#303746" Margin="8,0" />

                                    <Grid Grid.Column="0" Margin="0,0,18,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="66" />
                                            <ColumnDefinition Width="118" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="42" />
                                            <RowDefinition Height="42" />
                                            <RowDefinition Height="42" />
                                            <RowDefinition Height="42" />
                                            <RowDefinition Height="42" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="幅值" Style="{StaticResource PulseLabelStyle}" />
                                        <TextBox Grid.Column="1" Text="{Binding CurrentMilliamp, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsParameterEditingEnabled}"
                                                 Style="{StaticResource PulseFieldStyle}" />
                                        <TextBlock Grid.Column="2" Text="mA" Style="{StaticResource PulseLabelStyle}" Margin="10,0,0,0" />

                                        <TextBlock Grid.Row="1" Text="脉冲宽度" Style="{StaticResource PulseLabelStyle}" />
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 Text="{Binding PulseWidthMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsParameterEditingEnabled}"
                                                 Style="{StaticResource PulseFieldStyle}" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="ms" Style="{StaticResource PulseLabelStyle}" Margin="10,0,0,0" />

                                        <TextBlock Grid.Row="2" Text="上升宽度" Style="{StaticResource PulseLabelStyle}" />
                                        <TextBox Grid.Row="2" Grid.Column="1"
                                                 Text="{Binding RiseWidthMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsParameterEditingEnabled}"
                                                 Style="{StaticResource PulseFieldStyle}" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="ms" Style="{StaticResource PulseLabelStyle}" Margin="10,0,0,0" />

                                        <TextBlock Grid.Row="3" Text="间隔宽度" Style="{StaticResource PulseLabelStyle}" />
                                        <TextBox Grid.Row="3" Grid.Column="1"
                                                 Text="{Binding IntervalWidthMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsParameterEditingEnabled}"
                                                 Style="{StaticResource PulseFieldStyle}" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="ms" Style="{StaticResource PulseLabelStyle}" Margin="10,0,0,0" />

                                        <TextBlock Grid.Row="4" Text="极性" Style="{StaticResource PulseLabelStyle}" />
                                        <ComboBox Grid.Row="4" Grid.Column="1"
                                                  IsEnabled="{Binding IsParameterEditingEnabled}"
                                                  SelectedValuePath="Content"
                                                  SelectedValue="{Binding Polarity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource StimulationComboBox}">
                                            <ComboBoxItem Content="不掉转" />
                                            <ComboBoxItem Content="调转" />
                                        </ComboBox>
                                    </Grid>

                                    <Grid Grid.Column="2" Margin="18,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="66" />
                                            <ColumnDefinition Width="118" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="42" />
                                            <RowDefinition Height="42" />
                                            <RowDefinition Height="42" />
                                            <RowDefinition Height="42" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="治疗时间" Style="{StaticResource PulseLabelStyle}" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding TreatmentDurationSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsParameterEditingEnabled}"
                                                 Style="{StaticResource PulseFieldStyle}" />
                                        <TextBlock Grid.Column="2" Text="s" Style="{StaticResource PulseLabelStyle}" Margin="10,0,0,0" />

                                        <TextBlock Grid.Row="1" Text="监测" Style="{StaticResource PulseLabelStyle}" />
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 Text="{Binding MonitoringDisplay, Mode=OneWay}"
                                                 Style="{StaticResource PulseReadOnlyFieldStyle}" />

                                        <TextBlock Grid.Row="2" Text="总次数" Style="{StaticResource PulseLabelStyle}" />
                                        <TextBox Grid.Row="2" Grid.Column="1"
                                                 Text="{Binding PlannedTotalCount, Mode=OneWay}"
                                                 Style="{StaticResource PulseReadOnlyFieldStyle}" />

                                        <TextBlock Grid.Row="3" Text="计数阈值" Style="{StaticResource PulseLabelStyle}" />
                                        <TextBox Grid.Row="3" Grid.Column="1"
                                                 Text="{Binding CountThresholdDisplay, Mode=OneWay}"
                                                 Style="{StaticResource PulseReadOnlyFieldStyle}" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="%" Style="{StaticResource PulseLabelStyle}" Margin="10,0,0,0" />
                                    </Grid>
                                </Grid>

                                <Border Grid.Row="2"
                                        Background="#121823"
                                        BorderBrush="#2B3442"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="16"
                                        MinHeight="190">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Right"
                                                    Background="#1A2230"
                                                    BorderBrush="#303B4D"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="2">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton Content="60 秒"
                                                                 GroupName="{Binding Name}"
                                                                 Style="{StaticResource PulseWaveformModeOption}"
                                                                 IsChecked="{Binding Waveform.IsWindowView, Mode=TwoWay}" />
                                                    <RadioButton Content="全程"
                                                                 GroupName="{Binding Name}"
                                                                 Style="{StaticResource PulseWaveformModeOption}"
                                                                 IsChecked="{Binding Waveform.IsGlobalView, Mode=TwoWay}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding DataContext.Localization.WaveformLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#D9E1EE"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                        <Border Grid.Row="1"
                                                Margin="0,12,0,0"
                                                BorderBrush="#273240"
                                                BorderThickness="1"
                                                Background="#101620">
                                            <renderers:PulseCurrentWaveformSurface State="{Binding Waveform}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</UserControl>
