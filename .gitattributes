# Keep repository text files deterministic across Visual Studio, Git and CI.
* text=auto

/.gitattributes text eol=lf
/.editorconfig   text eol=lf
/.gitignore      text eol=lf

# Windows/.NET source and project files use CRLF in the working tree.
*.cs       text eol=crlf
*.xaml     text eol=crlf
*.csproj   text eol=crlf
*.props    text eol=crlf
*.targets  text eol=crlf
*.resx     text eol=crlf
*.xml      text eol=crlf
*.config   text eol=crlf
*.manifest text eol=crlf
*.ps1      text eol=crlf
*.slnx     text eol=crlf

# Documentation and structured data stay LF for portable diffs.
*.md     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sha256 text eol=lf

# Binary assets are never line-ending normalized.
*.png  binary
*.jpg  binary
*.jpeg binary
*.dll  binary

# Keep bundled media and tools out of the normal Git object store.
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text
