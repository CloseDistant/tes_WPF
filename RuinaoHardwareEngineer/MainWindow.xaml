                                    </WrapPanel>
                                    <WrapPanel>
                                        <StackPanel Width="150" Margin="0,0,12,12">
                                            <TextBlock Text="幅值 mA" Foreground="{StaticResource MutedBrush}" />
                                            <TextBox x:Name="ProductTpcsCurrentTextBox"
                                                     Text="0.01"
                                                     FontFamily="Consolas"
                                                     TextChanged="ProductTpcsInput_Changed" />
                                        </StackPanel>
                                        <StackPanel Width="150" Margin="0,0,12,12">
                                            <TextBlock Text="治疗时间 s" Foreground="{StaticResource MutedBrush}" />
                                            <TextBox x:Name="ProductTpcsDurationTextBox"
                                                     Text="1200.0"
                                                     FontFamily="Consolas"
                                                     TextChanged="ProductTpcsInput_Changed" />
