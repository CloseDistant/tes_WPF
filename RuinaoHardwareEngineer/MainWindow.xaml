                                    </WrapPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="脉冲时间参数"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <StackPanel Width="150" Margin="0,0,12,12">
                                            <TextBlock Text="上升宽度 ms" Foreground="{StaticResource MutedBrush}" />
                                            <TextBox x:Name="ProductTpcsRampWidthTextBox"
                                                     Text="5"
                                                     FontFamily="Consolas"
                                                     TextChanged="ProductTpcsInput_Changed" />
                                        </StackPanel>
                                        <StackPanel Width="150" Margin="0,0,12,12">
                                            <TextBlock Text="脉冲宽度 ms" Foreground="{StaticResource MutedBrush}" />
                                            <TextBox x:Name="ProductTpcsPulseWidthTextBox"
                                                     Text="10"
                                                     FontFamily="Consolas"
                                                     TextChanged="ProductTpcsInput_Changed" />
                                        </StackPanel>
                                        <StackPanel Width="150" Margin="0,0,12,12">
                                            <TextBlock Text="间隔宽度 ms" Foreground="{StaticResource MutedBrush}" />
                                            <TextBox x:Name="ProductTpcsIntervalWidthTextBox"
                                                     Text="20"
                                                     FontFamily="Consolas"
                                                     TextChanged="ProductTpcsInput_Changed" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <StackPanel Width="150" Margin="0,0,12,12">
                                            <TextBlock Text="计划总次数（只读）" Foreground="{StaticResource MutedBrush}" />
                                            <TextBox x:Name="ProductTpcsTotalCountTextBox"
                                                     Text="—"
                                                     IsReadOnly="True"
                                                     IsTabStop="False"
                                                     FontFamily="Consolas"
                                                     Background="#EEF1F6" />
                                        </StackPanel>
                                        <StackPanel Width="150" Margin="0,0,12,12">
                                            <TextBlock Text="计数阈值 %" Foreground="{StaticResource MutedBrush}" />
                                            <TextBox x:Name="ProductTpcsCountThresholdTextBox"
                                                     Text=""
                                                     FontFamily="Consolas"
                                                     ToolTip="当前不参与波形生成，等待后续业务定义。" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock Text="计数阈值当前仅保留界面位置，不参与模拟，也不会下发硬件。"
                                               Foreground="#B36200"
                                               TextWrapping="Wrap" />
