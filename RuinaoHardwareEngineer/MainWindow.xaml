                            </Grid>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Padding="14" Background="#151B28" CornerRadius="8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="当前阶段（软件模拟）" Foreground="#AAB4C8" />
                                    <TextBlock x:Name="ProductTpcsStageText"
                                               Text="尚未运行"
                                               Margin="0,6,0,0"
                                               Foreground="#FFD04A"
                                               FontWeight="Bold"
                                               FontSize="18" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Padding="14" Background="#151B28" CornerRadius="8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="目标脉冲电流" Foreground="#AAB4C8" />
                                    <TextBlock x:Name="ProductTpcsTargetCurrentText"
                                               Text="+0.010 mA"
                                               Margin="0,6,0,0"
                                               Foreground="#FFD04A"
                                               FontFamily="Consolas"
                                               FontWeight="Bold"
                                               FontSize="18" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Padding="14" Background="#151B28" CornerRadius="8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="当前次数（软件模拟）" Foreground="#AAB4C8" />
                                    <TextBlock x:Name="ProductTpcsCurrentCountText"
                                               Text="0 / —"
                                               Margin="0,6,0,0"
                                               Foreground="White"
                                               FontFamily="Consolas"
                                               FontWeight="Bold"
                                               FontSize="18" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="6" Padding="14" Background="#151B28" CornerRadius="8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="预计剩余时间" Foreground="#AAB4C8" />
                                    <TextBlock x:Name="ProductTpcsRemainingTimeText"
                                               Text="00:00:00.0"
                                               Margin="0,6,0,0"
                                               Foreground="White"
                                               FontFamily="Consolas"
                                               FontWeight="Bold"
                                               FontSize="18" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,14,0,0"
                                Padding="16"
                                Background="#111722"
                                BorderBrush="#2B3648"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="210" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="组合波形预览（软件模拟，非下位机实测）"
                                               Foreground="White"
                                               FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="ProductTpcsDetailViewButton"
                                                Content="脉冲细节"
                                                MinHeight="28"
                                                Padding="12,3"
                                                Background="#33415A"
                                                Foreground="White"
                                                Click="ProductTpcsDetailViewButton_Click" />
                                        <Button x:Name="ProductTpcsFullViewButton"
                                                Content="全程"
                                                MinHeight="28"
                                                Padding="12,3"
                                                Margin="0"
                                                Click="ProductTpcsFullViewButton_Click" />
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1"
                                        Margin="0,12,0,0"
                                        Background="#0D131E"
                                        BorderBrush="#344158"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid Margin="18,14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Canvas x:Name="ProductTpcsWaveformCanvas"
                                                Height="145"
                                                ClipToBounds="True">
                                            <Line X1="0" Y1="75" X2="760" Y2="75" Stroke="#40506A" StrokeThickness="1" />
                                            <Line X1="0" Y1="20" X2="0" Y2="130" Stroke="#40506A" StrokeThickness="1" />
                                            <Polyline x:Name="ProductTpcsWaveformLine"
                                                      Points="0,75 75,25 150,25 150,75 225,75 225,25 300,25 300,75 375,75 375,25 450,25 450,75 525,75 525,25 600,25 600,75"
                                                      Stroke="#4CA6FF"
                                                      StrokeThickness="3"
                                                      StrokeLineJoin="Round" />
                                        </Canvas>
                                        <TextBlock Grid.Row="1"
                                                   x:Name="ProductTpcsWaveformCaption"
                                                   Text="细节视图：第一次脉冲包含渐升，后续脉冲直接进入目标幅值。"
                                                   Foreground="#AAB4C8"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Padding="14"
                                Background="#F6F8FC"
                                BorderBrush="#DDE3EC"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="两段硬件映射预览"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="ProductTpcsHardwarePreviewText"
                                           Margin="0,8,0,0"
                                           FontFamily="Consolas"
                                           TextWrapping="Wrap"
                                           Text="参数尚未形成有效预览。" />
                            </StackPanel>
                        </Border>

                        <CheckBox x:Name="ProductTpcsTestLoadCheckBox"
                                  Margin="0,14,0,0"
                                  Content="已确认连接测试负载，不连接人体"
                                  Foreground="#9A3A00"
                                  FontWeight="SemiBold" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="生成产品预览"
                                    Click="ProductTpcsPreviewButton_Click" />
                            <Button Content="1. 下发配置（待确认）"
                                    IsEnabled="False"
                                    Background="#FFF1DD"
                                    ToolTip="脉冲硬件语义确认并实现共享DLL后开放。" />
                            <Button Content="2. 开始刺激（待确认）"
                                    IsEnabled="False"
                                    Background="#DDF6EA"
                                    ToolTip="当前界面不会发送任何tPCS硬件命令。" />
                            <Button Content="手动停止"
                                    IsEnabled="False"
                                    Background="#FFE3E3"
                                    ToolTip="tPCS硬件API尚未实现。" />
                        </WrapPanel>
                        <TextBlock x:Name="ProductTpcsStatusText"
                                   Margin="0,12,0,0"
                                   Text="界面设计阶段：不会向硬件发送tPCS配置或开始命令。"
                                   FontFamily="Consolas"
                                   Foreground="#8A5200"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="电刺激原始配置">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="usbtest4 V1.6组合波形原始参数"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="工程验证专用：复刻usbtest4 V1.6的原始参数、类型默认值和DA/电流显示换算；0x2E04编码未确认，最大正电流暂只作为换算标定值。"
                                       Margin="0,6,0,0"
                                       Foreground="#B36200"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Width="220"
                                    Margin="18,0,0,0">
                            <TextBlock Text="快速模板（仅修改表格，不下发）"
                                       Foreground="{StaticResource MutedBrush}" />
                            <ComboBox x:Name="RawConfigurationPresetComboBox"
                                      SelectedIndex="0"
                                      SelectionChanged="RawConfigurationPresetComboBox_SelectionChanged">
                                <ComboBoxItem Content="选择模板…" />
                                <ComboBoxItem Content="usbtest4默认组合" Tag="UsbTest4Default" />
                                <ComboBoxItem Content="单段类型8梯形" Tag="Trapezoid" />
                                <ComboBoxItem Content="单段类型10脉冲" Tag="Pulse" />
                                <ComboBoxItem Content="清空波形列表" Tag="Clear" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <WrapPanel Grid.Row="1" Margin="0,12,0,10">
                        <StackPanel Width="150" Margin="0,0,12,0">
                            <TextBlock Text="业务板地址" Foreground="{StaticResource MutedBrush}" />
                            <ComboBox x:Name="BoardAddressComboBox"
                                      ItemsSource="{Binding BoardAddressOptions}"
                                      DisplayMemberPath="Display"
                                      SelectionChanged="RawConfigurationInput_Changed" />
                        </StackPanel>
                        <StackPanel Width="110" Margin="0,0,12,0">
                            <TextBlock Text="刺激通道" Foreground="{StaticResource MutedBrush}" />
                            <ComboBox x:Name="StimulationChannelComboBox"
                                      ItemsSource="{Binding StimulationChannels}"
                                      SelectionChanged="StimulationChannelComboBox_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Width="130" Margin="0,0,12,0">
                            <TextBlock Text="使能掩码 0x2E00" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="StimulationEnableMaskTextBox"
                                     Text="0x01"
                                     FontFamily="Consolas"
                                     TextChanged="RawConfigurationInput_Changed" />
                        </StackPanel>
                        <StackPanel Width="130" Margin="0,0,12,0">
                            <TextBlock Text="配置版本 0x2E01" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="StimulationConfigVersionTextBox"
                                     Text="0x16"
                                     FontFamily="Consolas"
                                     TextChanged="RawConfigurationInput_Changed" />
                        </StackPanel>
                        <StackPanel Width="150" Margin="0,0,12,0">
                            <TextBlock Text="总运行时间 ms" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="TotalTimeMsTextBox"
                                     Text="600000"
                                     FontFamily="Consolas"
                                     TextChanged="RawConfigurationInput_Changed" />
                        </StackPanel>
                        <StackPanel Width="120" Margin="0,0,12,0">
                            <TextBlock Text="触发源掩码" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="TriggerSourceTextBox"
                                     Text="0"
                                     FontFamily="Consolas"
                                     TextChanged="RawConfigurationInput_Changed" />
                        </StackPanel>
                        <StackPanel Width="120" Margin="0,0,12,0">
                            <TextBlock Text="通道 flags" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="ChannelFlagsTextBox"
                                     Text="0"
                                     FontFamily="Consolas"
                                     TextChanged="RawConfigurationInput_Changed" />
                        </StackPanel>
                        <CheckBox x:Name="TriggerEnableCheckBox"
                                  Content="启用触发"
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,0,8"
                                  Checked="RawConfigurationInput_Changed"
                                  Unchecked="RawConfigurationInput_Changed" />
                    </WrapPanel>

                    <DataGrid Grid.Row="2"
                              x:Name="RawWaveformGrid"
                              ItemsSource="{Binding RawWaveformItems}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              CellEditEnding="RawWaveformGrid_CellEditEnding"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" Width="45" />
                            <DataGridTemplateColumn Header="类型" Width="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.WaveformTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Display"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding WaveformType, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectionChanged="RawWaveformTypeComboBox_SelectionChanged" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="持续us" Binding="{Binding DurationUs}" Width="90" />
                            <DataGridTextColumn Header="频率Hz" Binding="{Binding FrequencyHz}" Width="80" />
                            <DataGridTextColumn x:Name="AmplitudeColumn" Header="幅值" Binding="{Binding Amplitude}" Width="80" />
                            <DataGridTextColumn x:Name="OffsetColumn" Header="偏置" Binding="{Binding Offset}" Width="80" />
                            <DataGridTextColumn Header="相位" Binding="{Binding PhaseDegree}" Width="70" />
                            <DataGridTextColumn Header="占空/顺序" Binding="{Binding DutyOrder}" Width="90" />
                            <DataGridTextColumn x:Name="LowPositiveColumn" Header="低位/正相DA" Binding="{Binding LowPositive}" Width="105" />
                            <DataGridTextColumn x:Name="HighNegativeColumn" Header="高位/负相DA" Binding="{Binding HighNegative}" Width="105" />
                            <DataGridTextColumn Header="升/正时长" Binding="{Binding RisePositive}" Width="95" />
                            <DataGridTextColumn Header="平台/间隔" Binding="{Binding HoldInterval}" Width="95" />
                            <DataGridTextColumn Header="降/负时长" Binding="{Binding FallNegative}" Width="95" />
                            <DataGridTextColumn Header="自定义/周期间隔" Binding="{Binding CustomPeriod}" Width="125" />
                            <DataGridTextColumn Header="采样点" Binding="{Binding SampleCount}" Width="75" />
                            <DataGridTextColumn Header="重复" Binding="{Binding RepeatCount}" Width="70" />
                            <DataGridTextColumn Header="flags" Binding="{Binding Flags}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel>
                            <Button Content="增加波形"
                                    Click="AddWaveformButton_Click" />
                            <Button Content="增加脉冲波形"
                                    Click="AddPulseWaveformButton_Click" />
                            <Button Content="删除选中波形"
                                    Click="RemoveWaveformButton_Click" />
                            <Button x:Name="ToggleStimulationValueModeButton"
                                    Content="切换到电流模式"
                                    Click="ToggleStimulationValueModeButton_Click" />
                            <TextBlock Text="最大正电流 mA（0x2E04）"
                                       Margin="16,8,6,0"
                                       VerticalAlignment="Top" />
                            <TextBox x:Name="MaxCurrentMilliampereTextBox"
                                     Width="90"
                                     Text="15.000"
                                     IsEnabled="False"
                                     FontFamily="Consolas"
                                     LostFocus="MaxCurrentMilliampereTextBox_LostFocus" />
                            <Button x:Name="SendRawConfigurationButton"
                                    Content="下发全部配置"
                                    Click="SendRawConfigurationButton_Click"
                                    Background="#FFF1DD" />
                            <TextBlock x:Name="StimulationValueModeText"
                                       Margin="12,8,0,0"
                                       VerticalAlignment="Top"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="当前为DA模式：直接输入原始DA值。" />
                        </WrapPanel>
                        <CheckBox Grid.Column="1"
                                  x:Name="TestLoadConfirmedCheckBox"
                                  Content="已确认连接测试负载，不连接人体"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Checked="TestLoadConfirmedCheckBox_Changed"
                                  Unchecked="TestLoadConfirmedCheckBox_Changed"
                                  Foreground="#9A3A00"
                                  FontWeight="SemiBold" />
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="RawStimulationStatusText"
                                   Text="参数尚未下发。"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap" />
                        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                            <Button x:Name="SetAllChannelsHighButton"
                                    Content="0x0005 全通道打开"
                                    Click="SetAllChannelsHighButton_Click" />
                            <Button x:Name="StartRawStimulationButton"
                                    Content="0x0002 业务板开始（值0）"
                                    Click="StartRawStimulationButton_Click"
                                    Background="#DDF6EA" />
                            <Button x:Name="StartSelectedChannelButton"
                                    Content="0x0002 指定通道开始"
                                    Click="StartSelectedChannelButton_Click"
                                    Background="#DDF6EA" />
                            <Button x:Name="StopSelectedChannelButton"
                                    Content="0x0003 指定通道停止"
                                    Click="StopSelectedChannelButton_Click"
                                    Background="#FFE3E3" />
                            <Button x:Name="StopRawStimulationButton"
                                    Content="0x0003 业务板停止（值0）"
                                    Click="StopRawStimulationButton_Click"
                                    Background="#FFE3E3" />
                            <Button x:Name="SetAllChannelsLowButton"
                                    Content="0x0006 全通道拉低"
                                    Click="SetAllChannelsLowButton_Click" />
                            <Button x:Name="EmergencyStopAllBoardsButton"
                                    Content="全部在线板紧急停止"
                                    Click="EmergencyStopAllBoardsButton_Click"
                                    Background="#C62828"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Margin="18,0,0,0" />
                        </WrapPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="通信诊断">
                <TabControl Background="{StaticResource SurfaceBrush}" Padding="8">
                    <TabItem Header="握手稳定性与延迟">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14">
                                <TextBlock Text="连续执行真实背板握手，统计成功率与通信延迟。测试期间其他硬件操作会被锁定。"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" />
                                <WrapPanel Margin="0,14,0,0">
                                    <TextBlock Text="执行次数" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="StabilityCountTextBox" Text="100" Width="90" FontFamily="Consolas" />
                                    <TextBlock Text="间隔(ms)" VerticalAlignment="Center" Margin="20,0,8,0" />
                                    <TextBox x:Name="StabilityIntervalTextBox" Text="100" Width="90" FontFamily="Consolas" />
                                    <Button x:Name="StartHandshakeStabilityButton"
                                            Content="开始测试"
                                            Click="StartHandshakeStabilityButton_Click"
                                            Background="#DDF6EA"
                                            Margin="20,0,10,0" />
                                    <Button x:Name="StopDiagnosticButton"
                                            Content="停止"
                                            Click="StopDiagnosticButton_Click"
                                            IsEnabled="False"
                                            Margin="0" />
                                </WrapPanel>
                                <TextBlock x:Name="HandshakeStabilityProgressText"
                                           Text="尚未开始"
                                           Margin="0,14,0,0"
                                           FontWeight="SemiBold" />
                                <Border Margin="0,10,0,0" Padding="14" Background="#F6F8FC" CornerRadius="8">
                                    <TextBlock x:Name="HandshakeStabilityResultText"
                                               Text="成功率、最小/平均/P95/最大耗时将在这里显示。"
                                               FontFamily="Consolas"
                                               TextWrapping="Wrap" />
                                </Border>
                                <Separator Margin="0,18,0,16" />
                                <TextBlock Text="序号循环实机测试" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="把下一发送序号设置为65534，连续握手4次，验证序号是否按65534、65535、1、2循环，并检查硬件ACK。"
                                           Margin="0,6,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="SequenceCycleButton"
                                            Content="执行序号循环测试"
                                            Click="SequenceCycleButton_Click"
                                            Background="#E8EEFF" />
                                    <TextBlock x:Name="SequenceCycleResultText"
                                               Text="尚未测试"
                                               VerticalAlignment="Center"
                                               FontFamily="Consolas" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="寄存器批量读取">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="只读测试：从起始地址连续读取指定数量的背板寄存器，并按每批数量拆分请求。"
                                           Foreground="{StaticResource MutedBrush}" />
                                <WrapPanel Margin="0,12,0,0">
                                    <TextBlock Text="起始地址" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="BatchReadStartAddressTextBox" Text="0x0100" Width="100" FontFamily="Consolas" />
                                    <TextBlock Text="总数量" VerticalAlignment="Center" Margin="18,0,8,0" />
                                    <TextBox x:Name="BatchReadCountTextBox" Text="32" Width="70" FontFamily="Consolas" />
                                    <TextBlock Text="每批数量" VerticalAlignment="Center" Margin="18,0,8,0" />
                                    <TextBox x:Name="BatchReadSizeTextBox" Text="8" Width="70" FontFamily="Consolas" />
                                    <Button x:Name="StartBatchReadButton"
                                            Content="开始批量读取"
                                            Click="StartBatchReadButton_Click"
                                            Background="#E8EEFF"
                                            Margin="20,0,0,0" />
                                </WrapPanel>
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       x:Name="BatchReadSummaryText"
                                       Text="尚未读取"
                                       Margin="0,12,0,8"
                                       FontFamily="Consolas"
                                       TextWrapping="Wrap" />
                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding BatchRegisterItems}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="60" />
                                    <DataGridTextColumn Header="寄存器地址" Binding="{Binding AddressHex}" Width="140" />
                                    <DataGridTextColumn Header="十六进制值" Binding="{Binding ValueHex}" Width="180" />
                                    <DataGridTextColumn Header="UInt32" Binding="{Binding UnsignedValue}" Width="*" />
                                    <DataGridTextColumn Header="Int32" Binding="{Binding SignedValue}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="原始帧监视">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="RawFrameMonitorCheckBox"
                                              Content="启用监视"
                                              IsChecked="True"
                                              VerticalAlignment="Center"
                                              Checked="RawFrameMonitorCheckBox_Changed"
                                              Unchecked="RawFrameMonitorCheckBox_Changed" />
                                    <TextBlock x:Name="RawFrameCountText"
                                               Text="0帧"
                                               Margin="16,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                                <Button Content="清空帧"
                                        HorizontalAlignment="Right"
                                        MinHeight="28"
                                        Padding="12,3"
                                        Margin="0"
                                        Click="ClearRawFramesButton_Click" />
                            </Grid>
                            <DataGrid Grid.Row="1"
                                      x:Name="RawFrameGrid"
                                      Margin="0,10,0,0"
                                      ItemsSource="{Binding RawFrameItems}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="100" />
                                    <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="55" />
                                    <DataGridTextColumn Header="命令" Binding="{Binding Command}" Width="90" />
                                    <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="100" />
                                    <DataGridTextColumn Header="sendSeq" Binding="{Binding SendSequence}" Width="80" />
                                    <DataGridTextColumn Header="ackSeq" Binding="{Binding AckSequence}" Width="80" />
                                    <DataGridTextColumn Header="判定" Binding="{Binding MatchState}" Width="100" />
                                    <DataGridTextColumn Header="原始byte[]" Binding="{Binding Hex}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="USB/协议状态">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="只读诊断快照，每500ms自动刷新，不会向硬件发送命令。"
                                           Foreground="{StaticResource MutedBrush}" />
                                <Button Content="立即刷新"
                                        HorizontalAlignment="Right"
                                        MinHeight="28"
                                        Padding="12,3"
                                        Margin="0"
                                        Click="RefreshDiagnosticsButton_Click" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Padding="14" Background="#F6F8FC" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Text="USB链路" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock x:Name="UsbDiagnosticText"
                                                   Margin="0,10,0,0"
                                                   FontFamily="Consolas"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Padding="14" Background="#F6F8FC" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Text="协议运行状态" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock x:Name="ProtocolDiagnosticText"
                                                   Margin="0,10,0,0"
                                                   FontFamily="Consolas"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>

        <GridSplitter Grid.Column="1"
                      Width="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      Background="#DDE3EC" />

        <Border Grid.Column="2"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="12"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="12,12,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ToggleCommunicationLogButton"
                            Content="›"
                            Width="30"
                            MinHeight="28"
                            Padding="0"
                            Margin="0,0,10,0"
                            ToolTip="收起通信日志"
                            Click="ToggleCommunicationLogButton_Click" />
                    <TextBlock x:Name="CommunicationLogTitle"
                               Grid.Column="1"
                               Text="通信日志"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal"
                                Grid.Column="2"
                                x:Name="CommunicationLogCommands"
                                HorizontalAlignment="Right">
                        <Button Content="复制全部"
                                MinHeight="28"
                                Padding="12,3"
                                Margin="0,0,8,0"
                                Click="CopyAllLogButton_Click" />
                        <Button Content="清空"
                                MinHeight="28"
                                Padding="12,3"
                                Margin="0"
                                Click="ClearLogButton_Click" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" x:Name="CommunicationLogBody">
                    <ListBox x:Name="LogList"
                             ItemsSource="{Binding LogItems}"
                             BorderThickness="0"
                             Background="#FBFCFE"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" FontFamily="Consolas" Foreground="#657089" />
                                    <TextBlock Grid.Column="1" Text="{Binding Category}" FontFamily="Consolas" FontWeight="Bold" Foreground="#2357D9" />
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1"
                                               Grid.ColumnSpan="3"
                                               Text="{Binding Hex}"
                                               Visibility="{Binding HexVisibility}"
                                               Margin="0,4,0,0"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               Foreground="#3E4A62"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
