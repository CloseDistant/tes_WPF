<Window x:Class="RuinaoHardwareEngineer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="睿脑 tES 硬件工程师工具"
        Width="1500"
        Height="950"
        MinWidth="1100"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="tES 背板工程师工具"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="背板联机、8槽位拓扑、原始组合波形与通信诊断"
                           Margin="0,6,0,0"
                           FontSize="14"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <Border Grid.Column="1"
                    Padding="14,8"
                    CornerRadius="18"
                    Background="#E8EEFF"
                    VerticalAlignment="Center">
                <TextBlock x:Name="StateBadgeText"
                           Text="未联机"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}" />
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="12"
                Padding="18"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="设备" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="DeviceNameText" Text="正在检测…" Margin="0,5,0,0" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="硬件 ID" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="HardwareIdText" Text="VID_04B4 / PID_00F1" Margin="0,5,0,0" FontFamily="Consolas" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Windows 驱动" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="DriverStatusText" Text="未知" Margin="0,5,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="协议" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="V1.4帧 / usbtest4 V1.6配置" Margin="0,5,0,0" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="12"
                Padding="18"
                Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="版本字段" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="ProtocolVersionTextBox" Text="0x01" Width="100" FontFamily="Consolas" />
                    <TextBlock Text="超时(ms)" VerticalAlignment="Center" Margin="24,0,8,0" />
                    <TextBox x:Name="TimeoutTextBox" Text="5000" Width="110" FontFamily="Consolas" />
                </StackPanel>

                <WrapPanel Grid.Row="1" Margin="0,14,0,0">
                    <Button x:Name="RefreshButton" Content="刷新设备" Click="RefreshButton_Click" />
                    <Button x:Name="ConnectButton" Content="联机" Click="ConnectButton_Click" Background="#E8EEFF" />
                    <Button x:Name="HandshakeButton" Content="握手" Click="HandshakeButton_Click" Background="#DDF6EA" />
                    <Button x:Name="DisconnectButton" Content="断联" Click="DisconnectButton_Click" Margin="0" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CommunicationLogSplitterColumn" Width="6" />
                <ColumnDefinition x:Name="CommunicationLogColumn" Width="390" MinWidth="44" />
            </Grid.ColumnDefinitions>

        <TabControl Grid.Column="0">
            <TabItem Header="分组字符串读写">
                <Border Background="{StaticResource SurfaceBrush}"
                        Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="背板分组字符串读写" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="32组布局 · 每组32个寄存器 · UTF-8"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource MutedBrush}" />
                </Grid>
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="分组" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                        <ComboBox x:Name="ProductInfoGroupComboBox"
                                  ItemsSource="{Binding ProductInfoGroups}"
                                  SelectedIndex="0"
                                  SelectionChanged="ProductInfoGroupComboBox_SelectionChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="当前操作范围" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                        <TextBlock x:Name="ProductInfoGroupRangeText"
                                   Text="组0 · 0x0100～0x011F · 32个寄存器 / 128字节"
                                   FontFamily="Consolas"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
                <TextBox Grid.Row="2"
                         x:Name="ProductInfoTextBox"
                         Margin="0,10,0,0"
                         MinHeight="72"
                         MaxHeight="120"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="ProductInfoTextBox_TextChanged" />
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ProductInfoByteCountText"
                                   Text="UTF-8：0 / 127 字节"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="仅覆盖当前组，未使用部分补0；写完自动回读比较。"
                                   Margin="18,0,0,0"
                                   Foreground="#B36200" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1">
                        <Button x:Name="ReadProductInfoTextButton"
                                Content="读取当前组并解码"
                                Click="ReadProductInfoTextButton_Click"
                                Background="#E8EEFF" />
                        <Button x:Name="WriteProductInfoTextButton"
                                Content="编码写入并校验"
                                Click="WriteProductInfoTextButton_Click"
                                Background="#FFF1DD"
                                Margin="0" />
                    </WrapPanel>
                </Grid>
            </Grid>
                </Border>
            </TabItem>

            <TabItem Header="设备拓扑">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="背板下8槽位业务板拓扑"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="先读取背板0x0900槽位位图，再只访问已插板的业务板地址；当前硬件阶段通信正常的在线板统一作为电刺激板。"
                                       Margin="0,6,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="ScanTopologyButton"
                                Content="扫描8个槽位"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Click="ScanTopologyButton_Click"
                                Background="#E8EEFF" />
                    </Grid>
                    <TextBlock Grid.Row="1"
                               x:Name="TopologySummaryText"
                               Text="尚未扫描。读取背板槽位位图后，空槽位不会发送业务板请求。"
                               Margin="0,12,0,8"
                               FontFamily="Consolas"
                               TextWrapping="Wrap" />
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding BoardSlotItems}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="槽位" Binding="{Binding SlotIndex}" Width="60" />
                            <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="75" />
                            <DataGridTextColumn Header="状态" Binding="{Binding OnlineState}" Width="85" />
                            <DataGridTextColumn Header="板类型" Binding="{Binding BoardType}" Width="100" />
                            <DataGridTextColumn Header="身份文本" Binding="{Binding Identity}" Width="150" />
                            <DataGridTextColumn Header="板信息原始值" Binding="{Binding RawRegisters}" Width="260" />
                            <DataGridTextColumn Header="耗时" Binding="{Binding Elapsed}" Width="85" />
                            <DataGridTextColumn Header="判定说明" Binding="{Binding Status}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="通道阻抗">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="电刺激业务板通道阻抗"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Text="业务板来自“设备拓扑”的在线槽位。一次读取同时请求0x1001～0x1008；自动读取仅由软件每2秒重复请求，不发送硬件采集启停命令。" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top">
                            <Button x:Name="ReadStimulationImpedanceButton"
                                    Content="单次读取"
                                    MinWidth="96"
                                    Margin="0,0,8,0"
                                    Click="ReadStimulationImpedanceButton_Click"
                                    Background="#E8EEFF" />
                            <Button x:Name="StartStimulationImpedanceMonitoringButton"
                                    Content="每2秒自动读取"
                                    MinWidth="120"
                                    Margin="0,0,8,0"
                                    Click="StartStimulationImpedanceMonitoringButton_Click"
                                    Background="#E8F6EC" />
                            <Button x:Name="StopStimulationImpedanceMonitoringButton"
                                    Content="停止自动读取"
                                    MinWidth="110"
                                    Click="StopStimulationImpedanceMonitoringButton_Click"
                                    Background="#FBEAEA" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,14,0,12"
                            Padding="12"
                            Background="#F6F8FC"
                            BorderBrush="#DDE3EE"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="在线电刺激板槽位"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" />
                            <ComboBox Grid.Column="1"
                                      x:Name="ImpedanceBoardComboBox"
                                      ItemsSource="{Binding OnlineStimulationBoardOptions}"
                                      DisplayMemberPath="Display"
                                      SelectionChanged="ImpedanceBoardComboBox_SelectionChanged" />
                            <TextBlock Grid.Column="2"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="槽位决定业务板目标地址；当前阶段固定读取CH1～CH8。" />
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding StimulationImpedanceItems}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="刺激通道"
                                                Binding="{Binding ChannelDisplay}"
                                                Width="120" />
                            <DataGridTextColumn Header="阻抗寄存器"
                                                Binding="{Binding RegisterAddress}"
                                                Width="150" />
                            <DataGridTextColumn Header="原始值（16进制）"
                                                Binding="{Binding RawHex}"
                                                Width="190" />
                            <DataGridTextColumn Header="原始值（UInt32）"
                                                Binding="{Binding RawUnsigned}"
                                                Width="190" />
                            <DataGridTextColumn Header="阻抗（Ω）"
                                                Binding="{Binding ImpedanceOhms}"
                                                Width="150" />
                            <DataGridTextColumn Header="更新时间"
                                                Binding="{Binding UpdateTime}"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="3"
                            Margin="0,12,0,0"
                            Padding="10"
                            Background="#F6F8FC"
                            BorderBrush="#DDE3EE"
                            BorderThickness="1"
                            CornerRadius="4">
                        <TextBlock x:Name="ImpedanceStatusText"
                                   Text="请先在“设备拓扑”中扫描在线业务板。"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="产品 tDCS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="产品参数直流电刺激（tDCS）"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,6,0,16"
                                   Foreground="#B36200"
                                   TextWrapping="Wrap"
                                   Text="只生成一段类型8梯形。产品参数、单位转换、寄存器布局、发送顺序及硬件回复判断全部由RuinaoTesHardware.dll完成；仅允许连接测试负载。" />

                        <WrapPanel>
                            <StackPanel Width="150" Margin="0,0,12,12">
                                <TextBlock Text="在线电刺激板槽位" Foreground="{StaticResource MutedBrush}" />
                                <ComboBox x:Name="ProductTdcsBoardAddressComboBox"
                                          ItemsSource="{Binding OnlineStimulationBoardOptions}"
                                          DisplayMemberPath="Display"
                                          SelectedIndex="0"
                                          SelectionChanged="ProductTdcsInput_Changed" />
                            </StackPanel>
                            <StackPanel Width="120" Margin="0,0,12,12">
                                <TextBlock Text="刺激通道" Foreground="{StaticResource MutedBrush}" />
                                <ComboBox x:Name="ProductTdcsChannelComboBox"
                                          ItemsSource="{Binding StimulationChannels}"
                                          SelectedIndex="0"
                                          SelectionChanged="ProductTdcsInput_Changed" />
                            </StackPanel>
                            <StackPanel Width="150" Margin="0,0,12,12">
                                <TextBlock Text="模式" Foreground="{StaticResource MutedBrush}" />
                                <ComboBox x:Name="ProductTdcsModeComboBox"
                                          ItemsSource="{Binding DirectCurrentModeOptions}"
                                          DisplayMemberPath="Display"
                                          SelectedValuePath="Value"
                                          SelectedIndex="0"
                                          SelectionChanged="ProductTdcsMode_SelectionChanged" />
                            </StackPanel>
                            <StackPanel Width="150" Margin="0,0,12,12">
                                <TextBlock Text="极性" Foreground="{StaticResource MutedBrush}" />
                                <ComboBox x:Name="ProductTdcsPolarityComboBox"
                                          ItemsSource="{Binding DirectCurrentPolarityOptions}"
                                          DisplayMemberPath="Display"
                                          SelectedValuePath="Value"
                                          SelectedIndex="0"
                                          SelectionChanged="ProductTdcsInput_Changed" />
                            </StackPanel>
                        </WrapPanel>

                        <WrapPanel>
                            <StackPanel Width="150" Margin="0,0,12,12">
                                <TextBlock Text="幅值 mA" Foreground="{StaticResource MutedBrush}" />
                                <TextBox x:Name="ProductTdcsCurrentTextBox"
                                         Text="0.01"
                                         FontFamily="Consolas"
                                         TextChanged="ProductTdcsInput_Changed" />
                            </StackPanel>
                            <StackPanel Width="150" Margin="0,0,12,12">
                                <TextBlock Text="渐升时间 s" Foreground="{StaticResource MutedBrush}" />
                                <TextBox x:Name="ProductTdcsRampUpTextBox"
                                         Text="0.5"
                                         FontFamily="Consolas"
                                         TextChanged="ProductTdcsInput_Changed" />
                            </StackPanel>
                            <StackPanel Width="150" Margin="0,0,12,12">
                                <TextBlock Text="渐降时间 s" Foreground="{StaticResource MutedBrush}" />
                                <TextBox x:Name="ProductTdcsRampDownTextBox"
                                         Text="0.5"
                                         FontFamily="Consolas"
                                         TextChanged="ProductTdcsInput_Changed" />
                            </StackPanel>
                            <StackPanel Width="170" Margin="0,0,12,12">
                                <TextBlock Text="刺激时间（总时间）s" Foreground="{StaticResource MutedBrush}" />
                                <TextBox x:Name="ProductTdcsDurationTextBox"
                                         Text="120.0"
                                         FontFamily="Consolas"
                                         TextChanged="ProductTdcsInput_Changed" />
                            </StackPanel>
                            <StackPanel Width="150" Margin="0,0,12,12">
                                <TextBlock Text="间隔时间 s" Foreground="{StaticResource MutedBrush}" />
                                <TextBox x:Name="ProductTdcsIntervalTextBox"
                                         Text="0.0"
                                         FontFamily="Consolas"
                                         TextChanged="ProductTdcsInput_Changed" />
                            </StackPanel>
                            <StackPanel Width="150" Margin="0,0,12,12">
                                <TextBlock Text="单次时长 s" Foreground="{StaticResource MutedBrush}" />
                                <TextBox x:Name="ProductTdcsSingleDurationTextBox"
                                         Text="60.0"
                                         FontFamily="Consolas"
                                         TextChanged="ProductTdcsInput_Changed" />
                            </StackPanel>
                        </WrapPanel>

                        <Border Margin="0,4,0,14"
                                Padding="14"
                                Background="#F6F8FC"
                                BorderBrush="#DDE3EC"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="DLL硬件转换预览"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="ProductTdcsPreviewText"
                                           Margin="0,8,0,0"
                                           FontFamily="Consolas"
                                           TextWrapping="Wrap"
                                           Text="参数尚未形成有效的硬件配置。" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Padding="16"
                                    Background="#151B28"
                                    CornerRadius="8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="预计电流（软件计算，非实测）"
                                               Foreground="#AAB4C8" />
                                    <TextBlock x:Name="ProductTdcsExpectedCurrentText"
                                               Text="0.000 mA"
                                               Margin="0,6,0,0"
                                               Foreground="#FFD04A"
                                               FontFamily="Consolas"
                                               FontSize="28"
                                               FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2"
                                    Padding="16"
                                    Background="#151B28"
                                    CornerRadius="8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="预计剩余时间"
                                               Foreground="#AAB4C8" />
                                    <TextBlock x:Name="ProductTdcsRemainingTimeText"
                                               Text="00:00:00.0"
                                               Margin="0,6,0,0"
                                               Foreground="White"
                                               FontFamily="Consolas"
                                               FontSize="28"
                                               FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <CheckBox x:Name="ProductTdcsTestLoadCheckBox"
                                  Content="已确认连接测试负载，不连接人体"
                                  Foreground="#9A3A00"
                                  FontWeight="SemiBold"
                                  Checked="ProductTdcsTestLoad_Changed"
                                  Unchecked="ProductTdcsTestLoad_Changed" />

                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="ProductTdcsPreviewButton"
                                    Content="生成转换预览"
                                    Click="ProductTdcsPreviewButton_Click" />
                            <Button x:Name="ProductTdcsConfigureButton"
                                    Content="1. 下发配置"
                                    Click="ProductTdcsConfigureButton_Click"
                                    Background="#FFF1DD" />
                            <Button x:Name="ProductTdcsStartButton"
                                    Content="业务板开始（值0）"
                                    Click="ProductTdcsStartButton_Click"
                                    Background="#DDF6EA" />
                            <Button x:Name="ProductTdcsStartChannelButton"
                                    Content="2. 指定通道开始"
                                    Click="ProductTdcsStartChannelButton_Click"
                                    Background="#DDF6EA" />
                            <Button x:Name="ProductTdcsStopChannelButton"
                                    Content="指定通道停止"
                                    Click="ProductTdcsStopChannelButton_Click"
                                    Background="#FFE3E3" />
                            <Button x:Name="ProductTdcsStopButton"
                                    Content="业务板手动停止（值0）"
                                    Click="ProductTdcsStopButton_Click"
                                    Background="#FFE3E3" />
                        </WrapPanel>

                        <TextBlock x:Name="ProductTdcsStatusText"
                                   Margin="0,12,0,0"
                                   Text="参数尚未下发。"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="工程师软件不在总时间结束后追加停止或全通道拉低；可使用“手动停止”单独发送0x0003。" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="产品 tPCS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="产品参数脉冲电刺激（tPCS）"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           Text="第一段为类型8渐升，第二段为类型10脉冲循环；当前只完成产品界面、参数校验和软件模拟，不向硬件下发。" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Padding="12,6"
                                    Background="#FFF4D6"
                                    CornerRadius="14"
                                    VerticalAlignment="Top">
                                <TextBlock Text="设计确认中 · 禁止硬件下发"
                                           Foreground="#8A5200"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <Border Margin="0,16,0,0"
                                Padding="16"
                                Background="#F6F8FC"
                                BorderBrush="#DDE3EC"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="通道与刺激参数"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <WrapPanel Margin="0,12,0,0">
