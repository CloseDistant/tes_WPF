                                        <StackPanel Width="120" Margin="0,0,12,12">
                                            <TextBlock Text="刺激通道" Foreground="{StaticResource MutedBrush}" />
                                            <ComboBox x:Name="ProductTpcsChannelComboBox"
                                                      ItemsSource="{Binding StimulationChannels}"
                                                      SelectionChanged="ProductTpcsInput_Changed" />
                                        </StackPanel>
                                        <StackPanel Width="150" Margin="0,0,12,12">
                                            <TextBlock Text="极性" Foreground="{StaticResource MutedBrush}" />
                                            <ComboBox x:Name="ProductTpcsPolarityComboBox"
                                                      ItemsSource="{Binding DirectCurrentPolarityOptions}"
                                                      DisplayMemberPath="Display"
                                                      SelectedValuePath="Value"
                                                      SelectionChanged="ProductTpcsInput_Changed" />
